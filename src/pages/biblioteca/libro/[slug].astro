---
import BibliotecaLayout from "../../../layouts/BibliotecaLayout.astro";
import libraryData from "../../../data/processed/library.json";

export async function getStaticPaths() {
    const { books } = libraryData;
    return (books as any[]).map((book: any) => ({
        params: { slug: book.slug },
        props: { book },
    }));
}

const { book } = Astro.props;

if (!book) {
    return Astro.redirect("/404");
}

const seoDescription = `Libro: ${book.title} por ${book.authors.join(", ")}. Publicado por ${book.publisher || "Editorial conocida"}. Descubre más en nuestra biblioteca.`;

// JSON-LD for Book Schema
const schemData = {
    "@context": "https://schema.org",
    "@type": "Book",
    name: book.title,
    author: book.authors.map((name: string) => ({
        "@type": "Person",
        name: name,
    })),
    publisher: {
        "@type": "Organization",
        name: book.publisher || "Biblioteca Cantaribeña",
    },
    isbn: book.isbn,
    description: book.personalNotes || seoDescription,
    image: book.coverUrl
        ? new URL(book.coverUrl, Astro.url.origin).toString()
        : undefined,
};
---

<BibliotecaLayout
    title={book.title}
    description={seoDescription}
    image={book.coverUrl}
    type="book"
>
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemData)} />
    <div class="book-detail-page">
        <div class="breadcrumb">
            <a href="/biblioteca">Inicio</a> / <a href="/biblioteca/catalogo"
                >Catálogo</a
            > / <span>{book.title}</span>
        </div>

        <div class="book-container">
            <!-- Columna Izquierda: Portada -->
            <div class="book-visual">
                <div class="cover-wrapper">
                    {
                        book.coverUrl ? (
                            <img
                                src={book.coverUrl}
                                alt={book.title}
                                transition:name={`cover-${book.slug}`}
                            />
                        ) : (
                            <div class="placeholder-cover">{book.title[0]}</div>
                        )
                    }
                </div>

                <div class="book-read-status">
                    {
                        book.readStatus.isRead ? (
                            <span class="status-badge read">
                                ✅ Leído en casa
                            </span>
                        ) : (
                            <span class="status-badge unread">
                                ⏳ En lista de espera
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Columna Derecha: Detalles -->
            <div class="book-info">
                <h1 class="main-title">{book.title}</h1>
                <h2 class="authors">Por {book.authors.join(", ")}</h2>

                <div class="meta-row">
                    <div class="meta-item">
                        <span class="label">Editorial</span>
                        <span class="value"
                            >{book.publisher || "Desconocida"}</span
                        >
                    </div>
                    {
                        book.establishDate && (
                            <div class="meta-item">
                                <span class="label">Publicado</span>
                                <span class="value">{book.publishDate}</span>
                            </div>
                        )
                    }
                    {
                        book.pageCount && (
                            <div class="meta-item">
                                <span class="label">Páginas</span>
                                <span class="value">{book.pageCount}</span>
                            </div>
                        )
                    }
                    <div class="meta-item">
                        <span class="label">Edad Sugerida</span>
                        <span class="value">
                            {
                                book.ageRange.min
                                    ? `${book.ageRange.min}-${book.ageRange.max || "+"} años`
                                    : "Para todos"
                            }
                        </span>
                    </div>
                </div>

                <div class="divider"></div>

                {
                    book.personalNotes && (
                        <div class="personal-notes">
                            <h3>💭 Notas de la Familia</h3>
                            <p>{book.personalNotes}</p>
                        </div>
                    )
                }

                <div class="tags-section">
                    {
                        book.personalTags.map((tag: string) => (
                            <a
                                href={`/biblioteca/catalogo?search=${tag}`}
                                class="tag"
                            >
                                {tag}
                            </a>
                        ))
                    }
                </div>

                {
                    book.isbn && (
                        <div class="isbn-info">
                            <small>ISBN: {book.isbn}</small>
                        </div>
                    )
                }
                <div class="divider"></div>

                <div class="book-actions">
                    <h3>📢 Compartir esta joya</h3>
                    <div class="share-buttons">
                        <button
                            class="share-btn whatsapp"
                            id="share-whatsapp"
                            aria-label="Compartir en WhatsApp"
                        >
                            <span class="icon">💬</span> WhatsApp
                        </button>
                        <button
                            class="share-btn twitter"
                            id="share-twitter"
                            aria-label="Compartir en X"
                        >
                            <span class="icon">🐦</span> X
                        </button>
                        <button
                            class="share-btn copy"
                            id="share-copy"
                            aria-label="Copiar enlace"
                        >
                            <span class="icon">🔗</span>
                            <span id="copy-text">Copiar Link</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BibliotecaLayout>

<script>
    const title = document.title;
    const url = window.location.href;

    document.getElementById("share-whatsapp")?.addEventListener("click", () => {
        window.open(
            `https://api.whatsapp.com/send?text=${encodeURIComponent(title + " " + url)}`,
            "_blank",
        );
    });

    document.getElementById("share-twitter")?.addEventListener("click", () => {
        window.open(
            `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
            "_blank",
        );
    });

    document
        .getElementById("share-copy")
        ?.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(url);
                const textEl = document.getElementById("copy-text");
                if (textEl) {
                    textEl.textContent = "¡Copiado!";
                    setTimeout(
                        () => (textEl.textContent = "Copiar Link"),
                        2000,
                    );
                }
            } catch (err) {
                console.error("Error al copiar:", err);
            }
        });
</script>

<style>
    .book-actions {
        margin-top: 2rem;
    }

    .book-actions h3 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        opacity: 0.9;
    }

    .share-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .share-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        border: 1px solid var(--border-color);
        background: var(--surface-color);
        color: var(--text-color);
        cursor: pointer;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .share-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
        border-color: var(--primary-color);
    }

    .share-btn .icon {
        font-size: 1.1rem;
    }

    .share-btn.whatsapp:hover {
        background: #25d366;
        color: white;
        border-color: #25d366;
    }

    .share-btn.twitter:hover {
        background: #000;
        color: white;
        border-color: #000;
    }

    .share-btn.copy:hover {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }
    .book-detail-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 3rem 2rem;
    }

    .breadcrumb {
        margin-bottom: 3rem;
        font-size: 0.9rem;
        color: var(--text-color);
        opacity: 0.7;
    }

    .breadcrumb a {
        color: inherit;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .book-container {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 4rem;
        align-items: start;
    }

    .cover-wrapper {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        /* 3D effect hint */
        transform: rotateY(5deg);
        background: white;
    }

    .cover-wrapper img {
        width: 100%;
        height: auto;
        display: block;
    }

    .placeholder-cover {
        width: 100%;
        padding-top: 150%;
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        color: #ccc;
    }

    .book-read-status {
        margin-top: 2rem;
        text-align: center;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .status-badge.read {
        background: rgba(140, 179, 105, 0.2);
        color: var(--primary-color);
        border: 1px solid var(--primary-color);
    }

    .status-badge.unread {
        background: rgba(0, 0, 0, 0.05);
        color: var(--text-color);
        border: 1px solid var(--border-color);
    }

    .main-title {
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        color: var(--primary-color);
    }

    .authors {
        font-family: var(--font-body);
        font-size: 1.2rem;
        font-weight: 400;
        opacity: 0.8;
        margin-bottom: 2.5rem;
    }

    .meta-row {
        display: flex;
        gap: 3rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
    }

    .meta-item .label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.6;
        margin-bottom: 0.25rem;
    }

    .meta-item .value {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .divider {
        height: 1px;
        background: var(--border-color);
        margin: 2rem 0;
    }

    .personal-notes {
        background: var(--surface-color);
        padding: 2rem;
        border-radius: 12px;
        border-left: 4px solid var(--accent-color);
        margin-bottom: 2.5rem;
        box-shadow: var(--shadow);
    }

    .personal-notes h3 {
        margin-top: 0;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .tags-section {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .tag {
        padding: 0.4rem 1rem;
        background: rgba(var(--secondary-rgb), 0.1);
        color: var(--secondary-color);
        text-decoration: none;
        border-radius: 20px;
        font-size: 0.9rem;
        transition: background 0.3s;
    }

    .tag:hover {
        background: rgba(var(--secondary-rgb), 0.2);
    }

    .isbn-info {
        font-family: monospace;
        opacity: 0.5;
    }

    @media (max-width: 768px) {
        .book-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .cover-wrapper {
            max-width: 300px;
            margin: 0 auto;
            transform: rotateY(0deg);
        }
    }
</style>
