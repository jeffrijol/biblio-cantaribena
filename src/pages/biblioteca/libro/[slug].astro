---
import BibliotecaLayout from "../../layouts/BibliotecaLayout.astro";
import libraryData from "../../data/processed/library.json";

export async function getStaticPaths() {
    const { books } = libraryData;
    return books.map((book) => ({
        params: { slug: book.slug },
        props: { book },
    }));
}

const { book } = Astro.props;
---

<BibliotecaLayout title={book.title}>
    <div class="book-detail-page">
        <div class="breadcrumb">
            <a href="/biblioteca">Inicio</a> / <a href="/biblioteca/catalogo"
                >Catálogo</a
            > / <span>{book.title}</span>
        </div>

        <div class="book-container">
            <!-- Columna Izquierda: Portada -->
            <div class="book-visual">
                <div class="cover-wrapper">
                    {
                        book.coverUrl ? (
                            <img
                                src={book.coverUrl}
                                alt={book.title}
                                transition:name={`cover-${book.slug}`}
                            />
                        ) : (
                            <div class="placeholder-cover">{book.title[0]}</div>
                        )
                    }
                </div>

                <div class="book-read-status">
                    {
                        book.readStatus.isRead ? (
                            <span class="status-badge read">
                                ✅ Leído en casa
                            </span>
                        ) : (
                            <span class="status-badge unread">
                                ⏳ En lista de espera
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Columna Derecha: Detalles -->
            <div class="book-info">
                <h1 class="main-title">{book.title}</h1>
                <h2 class="authors">Por {book.authors.join(", ")}</h2>

                <div class="meta-row">
                    <div class="meta-item">
                        <span class="label">Editorial</span>
                        <span class="value"
                            >{book.publisher || "Desconocida"}</span
                        >
                    </div>
                    {
                        book.establishDate && (
                            <div class="meta-item">
                                <span class="label">Publicado</span>
                                <span class="value">{book.publishDate}</span>
                            </div>
                        )
                    }
                    {
                        book.pageCount && (
                            <div class="meta-item">
                                <span class="label">Páginas</span>
                                <span class="value">{book.pageCount}</span>
                            </div>
                        )
                    }
                    <div class="meta-item">
                        <span class="label">Edad Sugerida</span>
                        <span class="value">
                            {
                                book.ageRange.min
                                    ? `${book.ageRange.min}-${book.ageRange.max || "+"} años`
                                    : "Para todos"
                            }
                        </span>
                    </div>
                </div>

                <div class="divider"></div>

                {
                    book.personalNotes && (
                        <div class="personal-notes">
                            <h3>💭 Notas de la Familia</h3>
                            <p>{book.personalNotes}</p>
                        </div>
                    )
                }

                <div class="tags-section">
                    {
                        book.personalTags.map((tag) => (
                            <a
                                href={`/biblioteca/catalogo?search=${tag}`}
                                class="tag"
                            >
                                {tag}
                            </a>
                        ))
                    }
                </div>

                {
                    book.isbn && (
                        <div class="isbn-info">
                            <small>ISBN: {book.isbn}</small>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</BibliotecaLayout>

<style>
    .book-detail-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 3rem 2rem;
    }

    .breadcrumb {
        margin-bottom: 3rem;
        font-size: 0.9rem;
        color: var(--text-color);
        opacity: 0.7;
    }

    .breadcrumb a {
        color: inherit;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .book-container {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 4rem;
        align-items: start;
    }

    .cover-wrapper {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        /* 3D effect hint */
        transform: rotateY(5deg);
        background: white;
    }

    .cover-wrapper img {
        width: 100%;
        height: auto;
        display: block;
    }

    .placeholder-cover {
        width: 100%;
        padding-top: 150%;
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        color: #ccc;
    }

    .book-read-status {
        margin-top: 2rem;
        text-align: center;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .status-badge.read {
        background: rgba(140, 179, 105, 0.2);
        color: var(--primary-color);
        border: 1px solid var(--primary-color);
    }

    .status-badge.unread {
        background: rgba(0, 0, 0, 0.05);
        color: var(--text-color);
        border: 1px solid var(--border-color);
    }

    .main-title {
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        color: var(--primary-color);
    }

    .authors {
        font-family: var(--font-body);
        font-size: 1.2rem;
        font-weight: 400;
        opacity: 0.8;
        margin-bottom: 2.5rem;
    }

    .meta-row {
        display: flex;
        gap: 3rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
    }

    .meta-item .label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.6;
        margin-bottom: 0.25rem;
    }

    .meta-item .value {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .divider {
        height: 1px;
        background: var(--border-color);
        margin: 2rem 0;
    }

    .personal-notes {
        background: var(--surface-color);
        padding: 2rem;
        border-radius: 12px;
        border-left: 4px solid var(--accent-color);
        margin-bottom: 2.5rem;
        box-shadow: var(--shadow);
    }

    .personal-notes h3 {
        margin-top: 0;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .tags-section {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .tag {
        padding: 0.4rem 1rem;
        background: rgba(var(--secondary-rgb), 0.1);
        color: var(--secondary-color);
        text-decoration: none;
        border-radius: 20px;
        font-size: 0.9rem;
        transition: background 0.3s;
    }

    .tag:hover {
        background: rgba(var(--secondary-rgb), 0.2);
    }

    .isbn-info {
        font-family: monospace;
        opacity: 0.5;
    }

    @media (max-width: 768px) {
        .book-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .cover-wrapper {
            max-width: 300px;
            margin: 0 auto;
            transform: rotateY(0deg);
        }
    }
</style>
