---
import BibliotecaLayout from "../../../layouts/BibliotecaLayout.astro";
import libraryData from "../../../data/processed/library.json";

const { books } = libraryData;
---

<BibliotecaLayout title="Catálogo Completo">
    <div class="catalog-page">
        <header class="page-header">
            <h1 class="page-title">Catálogo Completo</h1>
            <p class="count-badge">{books.length} Libros en la Colección</p>
        </header>

        <div class="controls">
            <div class="search-wrapper">
                <input
                    type="text"
                    id="search-input"
                    placeholder="Buscar por título, autor o etiqueta..."
                    class="search-bar"
                    aria-label="Buscar libros"
                />
                <button
                    id="export-btn"
                    class="btn-util"
                    title="Exportar a CSV"
                    aria-label="Exportar colección a CSV"
                >
                    <span class="icon">📥</span> Exportar
                </button>
            </div>
        </div>

        <div class="catalog-grid" id="catalog-grid">
            {
                books.map((book) => (
                    <article
                        class="book-card"
                        data-keywords={book.searchKeywords}
                    >
                        <a
                            href={`/biblioteca/libro/${book.slug}`}
                            class="card-link"
                            data-astro-prefetch
                            aria-label={`Ver detalles de ${book.title}`}
                        >
                            <div class="card-cover">
                                {book.coverUrl ? (
                                    <img
                                        src={book.coverUrl}
                                        alt={book.title}
                                        loading="lazy"
                                        class="catalog-img"
                                    />
                                    <div class="placeholder" style="display: none;">
                                        {book.title[0]}
                                    </div>
                                ) : (
                                    <div class="placeholder">
                                        {book.title[0]}
                                    </div>
                                )}
                            </div>
                            <div class="card-details">
                                <h2 class="book-title">{book.title}</h2>
                                <p class="book-author">
                                    {book.authors.join(", ")}
                                </p>
                                <div class="tags">
                                    {book.personalTags
                                        .slice(0, 2)
                                        .map((tag) => (
                                            <span class="tag-small">{tag}</span>
                                        ))}
                                </div>
                            </div>
                        </a>
                    </article>
                ))
            }
        </div>

        <div id="no-results" class="no-results hidden">
            <p>No se encontraron libros que coincidan con tu búsqueda.</p>
        </div>
    </div>
</BibliotecaLayout>

<script>
    import libraryData from "../../../data/processed/library.json";
    const { books } = libraryData;

    const searchInput = document.getElementById("search-input");
    const exportBtn = document.getElementById("export-btn");
    const bookCards = document.querySelectorAll(".book-card");
    const noResults = document.getElementById("no-results");

    // Search logic
    if (searchInput) {
        searchInput.addEventListener("input", (e) => {
            const term = (e.target as HTMLInputElement).value.toLowerCase();
            let visibleCount = 0;

            bookCards.forEach((card) => {
                const keywords = card.getAttribute("data-keywords") || "";
                if (keywords.includes(term)) {
                    (card as HTMLElement).style.display = "block";
                    visibleCount++;
                } else {
                    (card as HTMLElement).style.display = "none";
                }
            });

            if (noResults) {
                if (visibleCount === 0) {
                    noResults.classList.remove("hidden");
                } else {
                    noResults.classList.add("hidden");
                }
            }
        });
    }

    // Export logic
    if (exportBtn) {
        exportBtn.addEventListener("click", () => {
            const headers = [
                "Título",
                "Autores",
                "Editorial",
                "ISBN",
                "Estado de Lectura",
            ];
            const csvContent = [
                headers.join(","),
                ...books.map((b) =>
                    [
                        `"${b.title}"`,
                        `"${b.authors.join(", ")}"`,
                        `"${b.publisher || ""}"`,
                        `"${b.isbn || ""}"`,
                        b.readStatus.isRead ? "Leído" : "No leído",
                    ].join(","),
                ),
            ].join("\n");

            const blob = new Blob([csvContent], {
                type: "text/csv;charset=utf-8;",
            });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute(
                "download",
                `biblioteca_cantaribena_${new Date().toISOString().split("T")[0]}.csv`,
            );
            link.style.visibility = "hidden";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    }
    // Image placeholder logic
    const catalogImages = document.querySelectorAll('.catalog-img');
    catalogImages.forEach(img => {
        const image = img as HTMLImageElement;
        const handleImageError = () => {
            image.style.display = 'none';
            const nextEl = image.nextElementSibling as HTMLElement;
            if (nextEl) nextEl.style.display = 'flex';
        };

        if (image.complete) {
            if (image.naturalWidth <= 1) handleImageError();
        } else {
            image.onload = () => {
                if (image.naturalWidth <= 1) handleImageError();
            };
            image.onerror = handleImageError;
        }
    });
</script>

<style>
    .catalog-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .page-title {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }

    .count-badge {
        display: inline-block;
        background: var(--surface-color);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        font-weight: 500;
    }

    .controls {
        max-width: 800px;
        margin: 0 auto 3rem;
    }

    .search-wrapper {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .search-bar {
        flex-grow: 1;
        padding: 1rem 1.5rem;
        font-size: 1.1rem;
        border: 2px solid var(--border-color);
        border-radius: 50px;
        background: var(--surface-color);
        color: var(--text-color);
        transition: all 0.3s;
    }

    .btn-util {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--surface-color);
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        padding: 0.8rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        white-space: nowrap;
    }

    .btn-util:hover {
        background: var(--primary-color);
        color: white;
    }

    .search-bar:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(var(--primary-rgb), 0.1);
    }

    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 2.5rem;
    }

    .book-card {
        background: var(--surface-color);
        border-radius: 12px;
        overflow: hidden;
        transition:
            transform 0.3s,
            box-shadow 0.3s;
        border: 1px solid var(--border-color);
        height: 100%;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .card-cover {
        aspect-ratio: 2/3;
        overflow: hidden;
        position: relative;
        background: #f0f0f0;
    }

    .card-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: #ccc;
        background: #eee;
    }

    .card-details {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .book-title {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        margin: 0 0 0.5rem;
        line-height: 1.3;
    }

    .book-author {
        font-size: 0.9rem;
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }

    .tags {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .tag-small {
        font-size: 0.7rem;
        padding: 0.1rem 0.5rem;
        background: rgba(var(--primary-rgb), 0.1);
        border-radius: 10px;
        color: var(--primary-color);
        white-space: nowrap;
    }

    .no-results {
        text-align: center;
        padding: 3rem;
        font-size: 1.2rem;
        opacity: 0.6;
    }

    .hidden {
        display: none;
    }
</style>
