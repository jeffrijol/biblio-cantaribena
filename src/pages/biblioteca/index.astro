---
import BibliotecaLayout from "../../layouts/BibliotecaLayout.astro";
import PichuCorner from "../../components/Biblioteca/PichuCorner.astro";
import InteractiveAgeTree from "../../components/Biblioteca/InteractiveAgeTree.astro";
import CollectionPreview from "../../components/Biblioteca/CollectionPreview.astro";
import FrequentAuthors from "../../components/Biblioteca/FrequentAuthors.astro";
import RandomBookPicker from "../../components/Biblioteca/RandomBookPicker.astro";
---

<BibliotecaLayout title="Inicio">
    <div class="library-grid">
        <!-- 1. Collection Preview: Explora Nuestros Tesoros (Contenido principal, ancho completo Fila 1) -->
        <div class="grid-item collection-area">
            <CollectionPreview />
        </div>

        <!-- 0. Decoration/Sidebar (empieza en la Fila 2) -->
        <div class="grid-item decoration-area">
            <div class="vertical-text">BIBLIOTECA CANTARIBEÑA</div>
        </div>

        <!-- 2. Pichu Corner & Random Picker (Row 2) -->
        <div class="grid-item pichu-area">
            <PichuCorner />
        </div>
        <div class="grid-item picker-area">
            <RandomBookPicker />
        </div>

        <!-- 3. Legend Section & Frequent Authors (Row 3) -->
        <div class="grid-item legend-area">
            <div class="library-legend">
                <h3>📖 Símbolos de nuestra colección</h3>
                <div class="legend-items">
                    <div class="legend-item">
                        <span class="icon">🌍</span>
                        <span
                            ><strong>Libros Viajeros:</strong> Traídos de nuestros
                            viajes o sobre otras tierras.</span
                        >
                    </div>
                    <div class="legend-item">
                        <span class="icon">🎨</span>
                        <span
                            ><strong>Arte e Ilustración:</strong> Selección especial
                            por su valor visual.</span
                        >
                    </div>
                    <div class="legend-item">
                        <span class="icon">❤️</span>
                        <span
                            ><strong>Favoritos:</strong> Joyas que leemos una y otra
                            vez.</span
                        >
                    </div>
                    <div class="legend-item">
                        <span class="icon">✨</span>
                        <span
                            ><strong>Novedades:</strong> Recién llegados a la estantería.</span
                        >
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-item authors-area">
            <FrequentAuthors />
        </div>

        <!-- 4. Age Recommendations (Row 4) -->
        <div class="grid-item age-area">
            <InteractiveAgeTree compact={true} />
        </div>
    </div>
</BibliotecaLayout>

<style>
    .library-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-auto-rows: min-content;
        gap: 2rem;
        padding: 2rem;
        max-width: 1600px;
        margin: 0 auto;
    }

    .grid-item {
        border-radius: 16px;
        overflow: hidden;
    }

    /* Row 1: Collection (Full Width) */
    .collection-area {
        grid-column: 1 / span 5;
        grid-row: 1;
    }

    /* 0. Decoration: empieza en Fila 2 hasta el final */
    .decoration-area {
        grid-column: 1;
        grid-row: 2 / span 3;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(var(--primary-rgb), 0.05);
        border-radius: 50px;
        margin-right: 1rem;
    }

    /* Row 2: Pichu & Random Picker */
    .pichu-area {
        grid-column: 2 / span 2;
        grid-row: 2;
    }

    .picker-area {
        grid-column: 4 / span 2;
        grid-row: 2;
    }

    /* Row 3: Legend & Authors */
    .legend-area {
        grid-column: 2 / span 2;
        grid-row: 3;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        padding: 2rem;
        border-radius: 16px;
    }

    .authors-area {
        grid-column: 4 / span 2;
        grid-row: 3;
    }

    /* Row 4: Age Recommendations */
    .age-area {
        grid-column: 2 / span 4;
        grid-row: 4;
    }

    .library-legend h3 {
        margin-top: 0;
        margin-bottom: 1.5rem;
        color: var(--primary-color);
        font-family: var(--font-heading);
    }

    .legend-items {
        display: grid;
        grid-template-columns: 1fr; /* Stacked for better fit in smaller column */
        gap: 1.2rem;
    }

    .legend-item {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        font-size: 0.9rem;
    }

    .legend-item .icon {
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .vertical-text {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-family: var(--font-heading);
        font-size: 2rem;
        color: var(--primary-color);
        opacity: 0.3;
        letter-spacing: 0.5rem;
        text-align: center;
    }

    /* Responsive fallback */
    @media (max-width: 1024px) {
        .library-grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .decoration-area {
            display: none;
        }
    }
</style>
