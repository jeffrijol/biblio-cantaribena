---
import NightModeToggle from "../components/UI/NightModeToggle.astro";
import NightSky from "../components/UI/NightSky.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: string;
}

const {
    title,
    description = "Descubre nuestra colección curada de libros en la Biblioteca Cantaribeña.",
    image = "/images/og-library.jpg",
    type = "website",
} = Astro.props;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "http://localhost:4321",
);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Biblioteca Cantaribeña</title>

        <!-- SEO Meta Tags -->
        <meta name="title" content={`${title} | Biblioteca Cantaribeña`} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            // Theme initialization
            const theme = localStorage.getItem("theme");
            if (
                theme === "dark" ||
                (!theme &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.setAttribute("data-theme", "light");
            }

            // Reading mode initialization
            const readingMode = localStorage.getItem("reading-mode");
            if (readingMode === "enabled") {
                document.documentElement.setAttribute(
                    "data-reading",
                    "enabled",
                );
            }
        </script>
    </head>
    <body class="bg-transition">
        <NightSky />
        <header class="layout-header">
            <nav class="nav-actions">
                <button
                    id="reading-mode-toggle"
                    class="util-btn"
                    title="Modo Lectura"
                    aria-label="Alternar modo lectura"
                >
                    <span class="icon">📖</span>
                </button>
                <NightModeToggle />
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="footer-content">
                <p>
                    &copy; {new Date().getFullYear()} Nuestra Biblioteca. Donde las
                    historias cobran vida.
                </p>
                <div class="footer-links">
                    <a href="/biblioteca">Inicio</a>
                    <a href="/biblioteca/catalogo">Catálogo</a>
                </div>
            </div>
        </footer>

        <script>
            const toggle = document.getElementById("reading-mode-toggle");
            if (toggle) {
                toggle.addEventListener("click", () => {
                    const isEnabled =
                        document.documentElement.getAttribute(
                            "data-reading",
                        ) === "enabled";
                    if (isEnabled) {
                        document.documentElement.removeAttribute(
                            "data-reading",
                        );
                        localStorage.setItem("reading-mode", "disabled");
                    } else {
                        document.documentElement.setAttribute(
                            "data-reading",
                            "enabled",
                        );
                        localStorage.setItem("reading-mode", "enabled");
                    }
                });
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        --primary-color: #8cb369;
        --secondary-color: #8ecae6;
        --accent-color: #ffb703;
        --background-color: #fffcf2;
        --surface-color: #ffffff;
        --text-color: #2d3142;
        --border-color: #e2e8f0;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);

        --font-heading: "Playfair Display", serif;
        --font-body: "Inter", sans-serif;
        --font-decorative: "Cormorant Garamond", serif;

        --text-base-size: 16px;
        --line-height-base: 1.6;
    }

    /* Reading Mode Variables */
    [data-reading="enabled"] {
        --text-base-size: 20px;
        --line-height-base: 1.8;
    }

    [data-theme="dark"] {
        --primary-color: #8cb369;
        --secondary-color: #219ebc;
        --accent-color: #ffb703;
        --background-color: #1a202c;
        --surface-color: #2d3748;
        --text-color: #e2e8f0;
        --border-color: #4a5568;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    html {
        background-color: var(--background-color);
        color: var(--text-color);
        font-family: var(--font-body);
        font-size: var(--text-base-size);
        transition:
            background-color 0.3s ease,
            color 0.3s ease,
            font-size 0.3s ease;
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: var(--line-height-base);
    }

    .layout-header {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        z-index: 1000;
    }

    .nav-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        background: var(--surface-color);
        padding: 0.5rem;
        border-radius: 50px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-color);
    }

    .util-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        font-size: 1.25rem;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background 0.3s;
    }

    .util-btn:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    main {
        flex: 1;
    }

    footer {
        text-align: center;
        padding: 4rem 2rem;
        border-top: 1px solid var(--border-color);
        margin-top: 4rem;
        background: var(--surface-color);
    }

    .footer-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .footer-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 1.5rem;
    }

    .footer-links a {
        color: var(--text-color);
        text-decoration: none;
        font-weight: 500;
        opacity: 0.7;
    }

    .footer-links a:hover {
        opacity: 1;
        color: var(--primary-color);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: var(--font-heading);
        line-height: 1.2;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    .bg-transition {
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }
</style>
