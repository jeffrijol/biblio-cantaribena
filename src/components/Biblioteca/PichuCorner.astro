---
import pichuCornerData from "../../data/processed/pichu-corner.json";
import libraryData from "../../data/processed/library.json";

const { books } = libraryData;
const { featuredBookId, anecdote, lastUpdated } = pichuCornerData;

const featuredBook = books.find((b) => b.id === featuredBookId) || books[0];
---

<section class="pichu-corner" id="rincon-pichu">
    <div class="corner-header">
        <h2 class="title">
            <span class="icon">📚</span>
            El Rincón de Pichu
        </h2>
        <p class="subtitle">Un espacio especial con historias familiares</p>
    </div>

    <div class="corner-content">
        <!-- Libro destacado -->
        <div class="featured-book">
            <div class="book-cover">
                {
                    featuredBook.coverUrl ? (
                        <img
                            src={featuredBook.coverUrl}
                            alt={featuredBook.title}
                            loading="lazy"
                            width="300"
                            height="450"
                            class="cover-image"
                        />
                    ) : (
                        <div class="cover-placeholder">
                            <span>{featuredBook.title}</span>
                        </div>
                    )
                }
                <div class="book-decoration">
                    <div class="bookmark"></div>
                    <div class="reading-light"></div>
                </div>
            </div>

            <div class="book-details">
                <h3 class="book-title">{featuredBook.title}</h3>
                <p class="book-author">{featuredBook.authors.join(", ")}</p>

                {
                    featuredBook.rating && (
                        <div class="rating">
                            {"★".repeat(Math.round(featuredBook.rating || 0))}
                            {"☆".repeat(
                                5 - Math.round(featuredBook.rating || 0),
                            )}
                            <span>({featuredBook.rating})</span>
                        </div>
                    )
                }

                <div class="tags">
                    {
                        featuredBook.personalTags
                            .slice(0, 3)
                            .map((tag) => <span class="tag">{tag}</span>)
                    }
                </div>
            </div>
        </div>

        <!-- Anécdota familiar -->
        <div class="anecdote-container">
            <div class="anecdote-header">
                <span class="anecdote-icon">💭</span>
                <h4>Por qué este libro es especial</h4>
            </div>
            <div class="anecdote-content">
                <p>{anecdote}</p>
                <div class="anecdote-meta">
                    <small>Actualizado: {lastUpdated}</small>
                    <a
                        href={`/biblioteca/libro/${featuredBook.slug}`}
                        class="see-more"
                    >
                        Ver ficha completa →
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Nota para editar -->
    <div class="edit-notice">
        <p>
            <small>
                ✏️ Para cambiar el libro destacado o la anécdota, edita el
                archivo
                <code>src/data/processed/pichu-corner.json</code>
            </small>
        </p>
    </div>
</section>

<style>
    .pichu-corner {
        background: linear-gradient(
            135deg,
            rgba(140, 179, 105, 0.05) 0%,
            rgba(142, 202, 230, 0.05) 100%
        );
        border-radius: 24px;
        padding: 3rem;
        margin: 4rem auto;
        max-width: 1200px;
        border: 1px solid var(--border-color);
        position: relative;
        overflow: hidden;
    }

    .corner-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }

    .title .icon {
        margin-right: 0.5rem;
    }

    .subtitle {
        font-family: var(--font-decorative);
        font-size: 1.2rem;
        opacity: 0.8;
    }

    .corner-content {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 3rem;
        align-items: start;
    }

    .featured-book {
        position: relative;
    }

    .book-cover {
        position: relative;
        width: 100%;
        max-width: 300px;
        margin: 0 auto;
    }

    .cover-image {
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cover-image:hover {
        transform: scale(1.03) rotateY(5deg);
    }

    .cover-placeholder {
        width: 100%;
        padding-top: 150%;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        text-align: center;
        padding: 2rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }

    .book-decoration {
        position: absolute;
        top: -10px;
        right: -10px;
        z-index: 2;
    }

    .bookmark {
        width: 30px;
        height: 100px;
        background: linear-gradient(135deg, #ffb703, #fb8500);
        clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 85%, 0 100%);
    }

    .reading-light {
        position: absolute;
        top: 10px;
        right: 35px;
        width: 40px;
        height: 40px;
        background: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.8) 0%,
            transparent 70%
        );
        border-radius: 50%;
    }

    .book-details {
        text-align: center;
        margin-top: 1.5rem;
    }

    .book-title {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        line-height: 1.3;
    }

    .book-author {
        font-style: italic;
        opacity: 0.8;
        margin-bottom: 1rem;
    }

    .rating {
        color: var(--accent-color);
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .rating span {
        font-size: 0.9rem;
        opacity: 0.7;
        margin-left: 0.5rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(var(--primary-rgb), 0.1);
        border: 1px solid rgba(var(--primary-rgb), 0.3);
        border-radius: 20px;
        font-size: 0.85rem;
        color: var(--primary-color);
    }

    .anecdote-container {
        background: var(--surface-color);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-color);
    }

    .anecdote-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .anecdote-icon {
        font-size: 2rem;
    }

    .anecdote-header h4 {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        margin: 0;
        color: var(--primary-color);
    }

    .anecdote-content p {
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
        font-family: var(--font-decorative);
    }

    .anecdote-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    .anecdote-meta small {
        opacity: 0.6;
    }

    .see-more {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.3s ease;
    }

    .see-more:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    .edit-notice {
        text-align: center;
        margin-top: 2rem;
        padding: 1rem;
        background: rgba(var(--primary-rgb), 0.05);
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .edit-notice code {
        background: rgba(0, 0, 0, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.85rem;
    }

    @media (max-width: 768px) {
        .pichu-corner {
            padding: 2rem;
            margin: 2rem 1rem;
        }

        .corner-content {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .book-cover {
            max-width: 250px;
        }

        .title {
            font-size: 2rem;
        }
    }
</style>
