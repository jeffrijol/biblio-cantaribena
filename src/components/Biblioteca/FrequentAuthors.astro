---
import libraryData from "../../data/processed/library.json";

interface Author {
  name: string;
  count: number;
  books: string[];
}

const { frequentAuthors = [] } = libraryData as { frequentAuthors: Author[] };
---

<section class="frequent-authors" id="autores-frecuentes">
  <div class="section-header">
    <h2 class="title">
      <span class="icon">✍️</span>
      Plumas Favoritas
    </h2>
    <p class="subtitle">Autores que llenan nuestras estanterías</p>
  </div>

  <div class="authors-grid">
    {
      frequentAuthors.slice(0, 6).map((author, index) => (
        <div class="author-card" style={`--delay: ${index * 100}ms`}>
          <div class="author-info">
            <h3 class="author-name">{author.name}</h3>
            <span class="book-count">{author.count} libros</span>
          </div>
          <div class="author-books">
            <span class="label">En colección:</span>
            <ul class="book-list">
              {author.books.map((book) => (
                <li>{book}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .frequent-authors {
    padding: 4rem 2rem;
    background-color: rgba(var(--primary-rgb), 0.03);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-family: var(--font-decorative);
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .author-card {
    background: var(--surface-color);
    padding: 2rem;
    border-radius: 16px;
    box-shadow: var(--shadow);
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease;
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  .author-card:hover {
    transform: translateY(-5px);
  }

  .author-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin: 0;
    color: var(--text-color);
  }

  .book-count {
    background: var(--primary-color);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .label {
    display: block;
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  .book-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .book-list li {
    padding: 0.25rem 0;
    font-size: 0.95rem;
    color: var(--text-color);
    opacity: 0.9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-list li::before {
    content: "•";
    color: var(--accent-color);
    margin-right: 0.5rem;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
