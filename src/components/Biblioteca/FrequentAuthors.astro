---
import libraryData from "../../data/processed/library.json";

interface Author {
    name: string;
    count: number;
    books: string[];
}

const { frequentAuthors = [] } = libraryData as { frequentAuthors: Author[] };

// Tomamos los top 12 para que se vea nutrido pero compacto
const displayAuthors = frequentAuthors.slice(0, 12);
---

<section class="frequent-authors" id="autores-frecuentes">
    <div class="authors-container">
        <div class="authors-intro">
            <h2 class="title">
                <span class="icon">✍️</span>
                Plumas Favoritas
            </h2>
            <p class="subtitle">Descubre los autores que más nos inspiran</p>
        </div>

        <div class="authors-pills">
            {
                displayAuthors.map((author, index) => (
                    <div
                        class="author-pill"
                        style={`--delay: ${index * 50}ms`}
                        title={`${author.count} libros en nuestra colección`}
                    >
                        <span class="author-name">{author.name}</span>
                        <span class="author-count">{author.count}</span>

                        <div class="author-tooltip">
                            <p class="tooltip-title">Libros destacados:</p>
                            <ul>
                                {author.books.slice(0, 2).map((book) => (
                                    <li>{book}</li>
                                ))}
                                {author.books.length > 2 && (
                                    <li class="more">
                                        ...y {author.count - 2} más
                                    </li>
                                )}
                            </ul>
                            <div class="tooltip-action">
                                Click para ver en el catálogo
                            </div>
                        </div>
                    </div>
                ))
            }

            <a href="/biblioteca/catalogo" class="pill-more">
                Ver todos los autores →
            </a>
        </div>
    </div>
</section>

<style>
    .frequent-authors {
        padding: 2.5rem 2rem;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        height: 100%;
        display: flex;
        align-items: center;
    }

    .authors-container {
        width: 100%;
    }

    .authors-intro {
        margin-bottom: 2rem;
        text-align: left;
    }

    .title {
        font-family: var(--font-heading);
        font-size: 1.8rem;
        color: var(--primary-color);
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .subtitle {
        font-family: var(--font-body);
        font-size: 0.95rem;
        opacity: 0.7;
    }

    .authors-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        justify-content: flex-start;
    }

    .author-pill {
        position: relative !important;
        background: rgba(var(--primary-rgb, 140, 179, 105), 0.1) !important;
        border: 1px solid rgba(var(--primary-rgb, 140, 179, 105), 0.2) !important;
        padding: 0.6rem 1.2rem !important;
        border-radius: 100px !important;
        cursor: pointer !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        display: flex !important;
        align-items: center !important;
        gap: 0.6rem !important;
        animation: pillIn 0.5s ease-out forwards !important;
        animation-delay: var(--delay) !important;
        opacity: 0;
        z-index: 1;
    }

    .author-pill:hover {
        background: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        transform: translateY(-3px) scale(1.05) !important;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
        z-index: 50 !important;
    }

    .author-pill:hover .author-name {
        color: white !important;
    }

    .author-name {
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        color: var(--text-color) !important;
        transition: color 0.3s ease !important;
    }

    .author-count {
        font-size: 0.75rem !important;
        background: rgba(var(--primary-rgb, 140, 179, 105), 0.2) !important;
        color: var(--primary-color) !important;
        min-width: 24px !important;
        height: 24px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        border-radius: 50% !important;
        transition: all 0.3s ease !important;
        font-weight: 700 !important;
    }

    .author-pill:hover .author-count {
        background: rgba(255, 255, 255, 0.3) !important;
        color: white !important;
    }

    /* Tooltip logic improved */
    .author-tooltip {
        position: absolute !important;
        bottom: calc(100% + 15px) !important;
        left: 50% !important;
        transform: translateX(-50%) translateY(10px) !important;
        background: var(--surface-color) !important;
        border: 1px solid var(--border-color) !important;
        padding: 1.2rem !important;
        border-radius: 16px !important;
        width: 240px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
        opacity: 0 !important;
        visibility: hidden !important;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        pointer-events: none !important;
        z-index: 100 !important;
    }

    .author-tooltip::after {
        content: "" !important;
        position: absolute !important;
        top: 100% !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        border-width: 10px !important;
        border-style: solid !important;
        border-color: var(--surface-color) transparent transparent transparent !important;
    }

    .author-pill:hover .author-tooltip {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateX(-50%) translateY(0) !important;
    }

    .tooltip-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        color: var(--primary-color);
    }

    .author-tooltip ul {
        list-style: none;
        padding: 0;
        margin: 0 0 0.8rem 0;
    }

    .author-tooltip li {
        font-size: 0.85rem;
        padding: 0.2rem 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .author-tooltip li.more {
        border-bottom: none;
        font-style: italic;
        opacity: 0.6;
        font-size: 0.8rem;
    }

    .tooltip-action {
        font-size: 0.7rem;
        background: var(--primary-color);
        color: white;
        padding: 0.3rem;
        border-radius: 4px;
        text-align: center;
        font-weight: 600;
    }

    .pill-more {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--primary-color);
        text-decoration: none;
        padding: 0.5rem 1rem;
        border: 1px dashed var(--primary-color);
        border-radius: 100px;
        transition: all 0.3s ease;
    }

    .pill-more:hover {
        background: var(--primary-color);
        color: white;
        border-style: solid;
    }

    @keyframes pillIn {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(5px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @media (max-width: 768px) {
        .frequent-authors {
            padding: 2rem 1rem;
        }
        .title {
            font-size: 1.5rem;
        }
        .author-tooltip {
            display: none; /* Mejor no mostrar tooltip en móvil */
        }
    }
</style>
