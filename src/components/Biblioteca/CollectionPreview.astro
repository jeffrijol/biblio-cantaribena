---
import libraryData from "../../data/processed/library.json";

const { books } = libraryData;

// Filtros "poéticos"
const filters = [
    { id: "all", label: "Toda la Colección", icon: "📚" },
    { id: "traveler", label: "Viajeros", icon: "🌍" },
    { id: "art", label: "Arte e Ilustración", icon: "🎨" },
    { id: "recent", label: "Novedades", icon: "✨" },
    { id: "favorite", label: "Favoritos", icon: "❤️" },
];

// Libros pre-filtrados para renderizado inicial (solo algunos ejemplos)
const previewBooks = books.slice(0, 12);
---

<section class="collection-preview" id="catalogo-preview">
    <div class="section-header">
        <h2 class="title">Colección de libros</h2>

        <div class="filters-scroll">
            <div class="filters-container">
                {
                    filters.map((filter) => (
                        <button
                            class={`filter-btn ${filter.id === "all" ? "active" : ""}`}
                            data-filter={filter.id}
                        >
                            <span class="filter-icon">{filter.icon}</span>
                            {filter.label}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="books-grid-container">
        <div class="books-grid" id="books-grid">
            {
                previewBooks.map((book) => (
                    <a
                        href={`/biblioteca/libro/${book.slug}`}
                        class="book-card-mini"
                    >
                        <div class="card-cover">
                            {book.coverUrl ? (
                                <img
                                    src={book.coverUrl}
                                    alt={book.title}
                                    loading="lazy"
                                />
                            ) : (
                                <div class="placeholder-cover">
                                    {book.title[0]}
                                </div>
                            )}
                        </div>
                        <div class="card-info">
                            <h4>{book.title}</h4>
                            <p>{book.authors[0]}</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>

    <div class="actions">
        <a href="/biblioteca/catalogo" class="btn btn-outline">
            Ver Catálogo Completo ({books.length} libros) →
        </a>
    </div>
</section>

<script>
    // Importar datos de libros al cliente para filtrado dinámico
    import libraryData from "../../data/processed/library.json";
    const allBooks = libraryData.books;

    document.addEventListener("DOMContentLoaded", () => {
        const buttons = document.querySelectorAll(".filter-btn");
        const grid = document.getElementById("books-grid");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Actualizar UI botones
                buttons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                // Filtrar
                const filterType = btn.getAttribute("data-filter");
                let filteredBooks: any[] = [];

                switch (filterType) {
                    case "traveler":
                        filteredBooks = allBooks.filter((b) => b.isTraveler);
                        break;
                    case "art":
                        filteredBooks = allBooks.filter((b) => b.isArtBook);
                        break;
                    case "recent":
                        filteredBooks = allBooks.filter((b) => b.isRecent);
                        break;
                    case "favorite":
                        filteredBooks = allBooks.filter((b) => b.isFavorite);
                        break;
                    default:
                        filteredBooks = allBooks;
                }

                // Renderizar (limitado a 12 para preview en scroll horizontal)
                renderBooks(filteredBooks.slice(0, 12));

                // Reiniciar scroll del contenedor
                if (grid) grid.scrollLeft = 0;
            });
        });

        function renderBooks(books: any[]) {
            if (!grid) return;
            grid.innerHTML = books
                .map(
                    (book: any) => `
        <a href="/biblioteca/libro/${book.slug}" class="book-card-mini fade-in">
          <div class="card-cover">
            ${
                book.coverUrl
                    ? `<img src="${book.coverUrl}" alt="${book.title}" loading="lazy" />`
                    : `<div class="placeholder-cover">${book.title[0]}</div>`
            }
          </div>
          <div class="card-info">
            <h4>${book.title}</h4>
            <p>${book.authors[0] || "Autor desconocido"}</p>
          </div>
        </a>
      `,
                )
                .join("");
        }
    });
</script>

<style>
    .collection-preview {
        padding: 3rem 1rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .title {
        font-family: var(--font-heading);
        font-size: 2.2rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
    }

    .filters-scroll {
        overflow-x: auto;
        padding-bottom: 1rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .filters-scroll::-webkit-scrollbar {
        display: none;
    }

    .filters-container {
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        min-width: max-content;
        padding: 0 1rem;
    }

    .filter-btn {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        cursor: pointer;
        font-family: var(--font-body);
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-color);
        white-space: nowrap;
    }

    .filter-btn:hover,
    .filter-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.2);
    }

    .books-grid-container {
        position: relative;
        margin: 0 -1rem 2.5rem -1rem;
        padding: 0 1rem;
    }

    .books-grid {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        padding: 1rem 0.5rem 2rem 0.5rem;
        scrollbar-width: thin;
        scrollbar-color: var(--primary-color) transparent;
        scroll-snap-type: x proximity;
        -webkit-overflow-scrolling: touch;
    }

    /* Estilo premium para el scrollbar */
    .books-grid::-webkit-scrollbar {
        height: 6px;
    }

    .books-grid::-webkit-scrollbar-track {
        background: rgba(var(--primary-rgb), 0.05);
        border-radius: 10px;
    }

    .books-grid::-webkit-scrollbar-thumb {
        background: var(--primary-color);
        border-radius: 10px;
        opacity: 0.5;
    }

    .book-card-mini {
        flex: 0 0 160px; /* Tamaño reducido */
        background: var(--surface-color);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        scroll-snap-align: start;
        border: 1px solid var(--border-color);
    }

    .book-card-mini:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        border-color: var(--primary-color);
    }

    .card-cover {
        aspect-ratio: 2/3;
        overflow: hidden;
        background: #f8f9fa;
        position: relative;
    }

    .card-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .placeholder-cover {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: #ddd;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .card-info {
        padding: 0.8rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .card-info h4 {
        margin: 0 0 0.3rem 0;
        font-size: 0.9rem;
        font-family: var(--font-heading);
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--text-color);
    }

    .card-info p {
        margin: 0;
        font-size: 0.75rem;
        opacity: 0.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 500;
    }

    .actions {
        text-align: center;
    }

    .btn-outline {
        display: inline-block;
        padding: 0.7rem 1.8rem;
        border: 2px solid var(--primary-color);
        border-radius: 50px;
        color: var(--primary-color);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-outline:hover {
        background: var(--primary-color);
        color: white;
        box-shadow: 0 4px 15px rgba(var(--primary-rgb), 0.3);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }

    /* Mobile adjustments */
    @media (max-width: 768px) {
        .title {
            font-size: 1.8rem;
        }
        .book-card-mini {
            flex: 0 0 140px;
        }
        .filters-container {
            justify-content: flex-start;
        }
    }
</style>
