---
import libraryData from "../../data/processed/library.json";

const { books } = libraryData;

// Filtros "poéticos"
const filters = [
    { id: "all", label: "Toda la Colección" },
    { id: "traveler", label: "Viajeros" },
    { id: "art", label: "Arte e Ilustración" },
    { id: "recent", label: "Novedades" },
    { id: "favorite", label: "Favoritos" },
];

// Libros pre-filtrados para renderizado inicial
// Filtramos libros que no tienen portada para mantener la estética de la sección
const previewBooks = books
    .filter((book) => book.coverUrl && book.coverUrl.trim() !== "")
    .slice(0, 50);
---

<section class="collection-preview" id="catalogo-preview">
    <div class="section-header">
        <h2 class="title">Biblioteca Cantaribeña</h2>

        <nav class="filters-nav" aria-label="Explorar biblioteca">
            <div class="filters-scroll">
                <div class="filters-container">
                    {
                        filters.map((filter) => (
                            <button
                                class={`filter-link ${filter.id === "all" ? "active" : ""}`}
                                data-filter={filter.id}
                            >
                                <span class="filter-text">{filter.label}</span>
                            </button>
                        ))
                    }
                    <div class="filter-divider"></div>
                    <a
                        href="/biblioteca/catalogo"
                        class="filter-link explore"
                        data-astro-prefetch
                    >
                        <span class="filter-text">Catálogo Completo</span>
                    </a>
                </div>
            </div>
        </nav>
    </div>

    <!-- Swiper Container -->
    <div class="carousel-outer-container">
        <div class="swiper-container-wrapper">
            <div class="swiper" id="books-swiper">
                <div class="swiper-wrapper" id="swiper-wrapper-el">
                    {
                        previewBooks.map((book) => (
                            <div class="swiper-slide card-slide">
                                <a
                                    href={`/biblioteca/libro/${book.slug}`}
                                    class="book-card-premium"
                                    data-astro-prefetch
                                    aria-label={`Ver detalles de ${book.title}`}
                                >
                                    <div class="card-cover">
                                        {book.coverUrl && (
                                            <img
                                                src={book.coverUrl}
                                                alt={book.title}
                                                loading="lazy"
                                                decoding="async"
                                                class="preview-book-img"
                                            />
                                        )}
                                    </div>
                                    <div class="card-info">
                                        <h4>{book.title}</h4>
                                        <p>
                                            {book.authors && book.authors[0]
                                                ? book.authors[0]
                                                : "Autor desconocido"}
                                        </p>
                                    </div>
                                </a>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Navigation Buttons -->
            <button class="nav-btn prev" id="swiper-prev" aria-label="Anterior">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"><path d="M15 18l-6-6 6-6"></path></svg
                >
            </button>
            <button
                class="nav-btn next"
                id="swiper-next"
                aria-label="Siguiente"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"><path d="M9 18l6-6-6-6"></path></svg
                >
            </button>
        </div>

        <div class="swiper-pagination-custom" id="swiper-pagination"></div>
    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Navigation, Pagination, FreeMode } from "swiper/modules";
    import "swiper/css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";
    import "swiper/css/free-mode";

    import libraryData from "../../data/processed/library.json";
    const allBooks = libraryData.books;

    let swiperInstance: any;

    function initSwiper() {
        if (swiperInstance) {
            swiperInstance.destroy(true, true);
        }

        const swiperEl = document.querySelector("#books-swiper");
        if (!swiperEl) return;

        swiperInstance = new Swiper("#books-swiper", {
            modules: [Navigation, Pagination, FreeMode],
            slidesPerView: "auto",
            spaceBetween: 30,
            grabCursor: true,
            loop: true,
            freeMode: {
                enabled: true,
                sticky: true,
            },
            navigation: {
                nextEl: "#swiper-next",
                prevEl: "#swiper-prev",
            },
            pagination: {
                el: "#swiper-pagination",
                clickable: true,
                dynamicBullets: true,
            },
            breakpoints: {
                320: { spaceBetween: 20 },
                1024: { spaceBetween: 30 },
            },
        });

        // Initialize listeners for images after swiper is ready
        setupImageCheckers();
    }

    function setupImageCheckers() {
        const images = document.querySelectorAll(".preview-book-img");
        images.forEach((img) => {
            const image = img as HTMLImageElement;
            const handleBadImage = () => {
                const slide = image.closest(".swiper-slide");
                if (slide) {
                    slide.remove();
                    if (swiperInstance) swiperInstance.update();
                }
            };

            if (image.complete) {
                if (image.naturalWidth <= 1) handleBadImage();
            } else {
                image.addEventListener("load", () => {
                    if (image.naturalWidth <= 1) handleBadImage();
                });
                image.addEventListener("error", handleBadImage);
            }
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        initSwiper();

        const filterLinks = document.querySelectorAll(
            ".filter-link[data-filter]",
        );
        const wrapper = document.getElementById("swiper-wrapper-el");

        filterLinks.forEach((link) => {
            link.addEventListener("click", () => {
                filterLinks.forEach((l) => l.classList.remove("active"));
                link.classList.add("active");

                const filterType = link.getAttribute("data-filter");
                let filteredBooks: any[] = [];

                const hasValidCover = (b: any) =>
                    b.coverUrl && b.coverUrl.trim() !== "";

                switch (filterType) {
                    case "traveler":
                        filteredBooks = allBooks.filter(
                            (b: any) => b.isTraveler && hasValidCover(b),
                        );
                        break;
                    case "art":
                        filteredBooks = allBooks.filter(
                            (b: any) => b.isArtBook && hasValidCover(b),
                        );
                        break;
                    case "recent":
                        filteredBooks = allBooks.filter(
                            (b: any) => b.isRecent && hasValidCover(b),
                        );
                        break;
                    case "favorite":
                        filteredBooks = allBooks.filter(
                            (b: any) => b.isFavorite && hasValidCover(b),
                        );
                        break;
                    default:
                        filteredBooks = allBooks.filter((b: any) =>
                            hasValidCover(b),
                        );
                }

                updateCarousel(filteredBooks.slice(0, 50));
            });
        });

        function updateCarousel(books: any[]) {
            if (!wrapper) return;

            wrapper.style.transition = "opacity 0.3s ease";
            wrapper.style.opacity = "0";

            setTimeout(() => {
                wrapper.innerHTML = books
                    .map(
                        (book: any) => `
                        <div class="swiper-slide card-slide">
                            <a href="/biblioteca/libro/${book.slug}" class="book-card-premium" data-astro-prefetch aria-label="Ver detalles de ${book.title}">
                                <div class="card-cover">
                                    ${
                                        book.coverUrl
                                            ? `<img src="${book.coverUrl}" alt="${book.title}" loading="lazy" decoding="async" class="preview-book-img" />`
                                            : ""
                                    }
                                </div>
                                <div class="card-info">
                                    <h4>${book.title}</h4>
                                    <p>${book.authors && book.authors[0] ? book.authors[0] : "Autor desconocido"}</p>
                                </div>
                            </a>
                        </div>
                    `,
                    )
                    .join("");

                initSwiper();
                wrapper.style.opacity = "1";
                if (swiperInstance) swiperInstance.slideToLoop(0, 0);
            }, 300);
        }
    });

    // Handle Astro page transitions
    document.addEventListener("astro:page-load", initSwiper);
</script>

<style>
    .collection-preview {
        padding: 6rem 1rem;
        max-width: 1400px;
        margin: 0 auto;
        overflow: hidden;
    }

    .section-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .title {
        font-family: var(--font-heading), serif;
        font-size: 4rem;
        color: var(--primary-color);
        margin-bottom: 3rem;
        letter-spacing: -1.5px;
        font-weight: 400;
    }

    .filters-nav {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .filters-scroll {
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 0.5rem;
        width: 100%;
        max-width: fit-content;
    }

    .filters-scroll::-webkit-scrollbar {
        display: none;
    }

    .filters-container {
        display: flex;
        align-items: center;
        gap: 3.5rem;
        padding: 0 2rem;
    }

    .filter-link {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--text-color);
        opacity: 0.45;
        text-decoration: none;
        font-family: var(--font-decorative), serif;
        font-size: 1.35rem;
        font-style: italic;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        position: relative;
        white-space: nowrap;
    }

    .filter-link::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 50%;
        width: 0;
        height: 1.5px;
        background: var(--primary-color);
        transition: all 0.5s ease;
        transform: translateX(-50%);
    }

    .filter-link:hover {
        opacity: 1;
        transform: translateY(-3px);
    }

    .filter-link.active {
        opacity: 1;
        color: var(--primary-color);
        transform: scale(1.08);
    }

    .filter-link.active::after {
        width: 100%;
    }

    .filter-divider {
        width: 1px;
        height: 22px;
        background: var(--border-color);
        margin: 0 0.5rem;
        opacity: 0.3;
    }

    .filter-link.explore {
        font-family: var(--font-body);
        font-style: normal;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 600;
        opacity: 0.7;
    }

    /* Carousel Styles */
    .carousel-outer-container {
        position: relative;
        padding: 2rem 0;
    }

    .swiper-container-wrapper {
        position: relative;
        padding: 0 4rem;
    }

    .swiper {
        width: 100%;
        padding-bottom: 3rem;
    }

    :global(.card-slide) {
        width: 220px !important;
        height: auto;
        opacity: 0.3;
        filter: grayscale(1);
        transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        transform: scale(0.8);
    }

    :global(.swiper-slide-active),
    :global(.swiper-slide-next),
    :global(.swiper-slide-next + .swiper-slide),
    :global(.swiper-slide-next + .swiper-slide + .swiper-slide) {
        opacity: 1;
        filter: grayscale(0);
        transform: scale(1);
    }

    :global(.book-card-premium) {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border-radius: 1px;
        overflow: hidden;
        text-decoration: none !important;
        color: inherit !important;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.05);
        height: 100%;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    :global(.book-card-premium:hover) {
        transform: translateY(-15px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
        border-color: var(--primary-color);
    }

    :global(.card-cover) {
        aspect-ratio: 2/3;
        overflow: hidden;
        position: relative;
        background: #fdfcf9;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
        min-height: 285px;
    }

    :global(.card-cover img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    :global(.book-card-premium:hover img) {
        transform: scale(1.05);
    }

    :global(.card-info) {
        padding: 1.5rem;
        flex-grow: 1;
        text-align: left;
    }

    :global(.card-info h4) {
        margin: 0 0 0.6rem 0;
        font-size: 1.1rem;
        font-family: var(--font-heading);
        line-height: 1.25;
        color: #1a1a1a;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    :global(.card-info p) {
        margin: 0;
        font-size: 0.8rem;
        opacity: 0.5;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .nav-btn {
        position: absolute;
        top: 45%;
        transform: translateY(-50%);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: white;
        border: 1px solid var(--border-color);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .nav-btn:hover {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
        box-shadow: 0 15px 40px rgba(var(--primary-rgb), 0.3);
        transform: translateY(-50%) scale(1.1);
    }

    .nav-btn.prev {
        left: 0;
    }
    .nav-btn.next {
        right: 0;
    }

    .swiper-pagination-custom {
        margin-top: 2rem;
        display: flex;
        justify-content: center;
    }

    @media (max-width: 1024px) {
        .title {
            font-size: 3rem;
        }
        .filters-container {
            gap: 2rem;
        }
        :global(.card-slide) {
            width: 180px !important;
        }
        .nav-btn {
            width: 50px;
            height: 50px;
        }
    }

    @media (max-width: 768px) {
        .title {
            font-size: 2.2rem;
        }
        .filters-container {
            gap: 1.5rem;
        }
        .filter-divider {
            display: none;
        }
        .swiper-container-wrapper {
            padding: 0 1rem;
        }
        .nav-btn {
            display: none;
        }
        :global(.card-slide) {
            width: 160px !important;
        }
        .collection-preview {
            padding: 4rem 1rem;
        }
    }
</style>
