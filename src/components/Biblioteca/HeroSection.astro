---
import libraryData from "../../data/processed/library.json";

const { books } = libraryData;

// Filtros "poéticos"
const filters = [
    { id: "all", label: "Toda la Colección", icon: "📚" },
    { id: "traveler", label: "Viajeros", icon: "🌍" },
    { id: "art", label: "Arte e Ilustración", icon: "🎨" },
    { id: "recent", label: "Novedades", icon: "✨" },
    { id: "favorite", label: "Favoritos", icon: "❤️" },
];

// Libros pre-filtrados para renderizado inicial (solo algunos ejemplos)
const previewBooks = books.slice(0, 8);
---

<section class="collection-preview" id="catalogo-preview">
    <div class="section-header">
        <h2 class="title">La biblioteca cantaribeña</h2>

        <div class="filters-scroll">
            <div class="filters-container">
                {
                    filters.map((filter) => (
                        <button
                            class={`filter-btn ${filter.id === "all" ? "active" : ""}`}
                            data-filter={filter.id}
                        >
                            <span class="filter-icon">{filter.icon}</span>
                            {filter.label}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="books-grid" id="books-grid">
        {
            previewBooks.map((book) => (
                <a
                    href={`/biblioteca/libro/${book.slug}`}
                    class="book-card-mini"
                >
                    <div class="card-cover">
                        {book.coverUrl ? (
                            <img
                                src={book.coverUrl}
                                alt={book.title}
                                loading="lazy"
                            />
                        ) : (
                            <div class="placeholder-cover">{book.title[0]}</div>
                        )}
                    </div>
                    <div class="card-info">
                        <h4>{book.title}</h4>
                        <p>{book.authors[0]}</p>
                    </div>
                </a>
            ))
        }
    </div>

    <div class="actions">
        <a href="/biblioteca/catalogo" class="btn btn-outline">
            Ver Catálogo Completo ({books.length} libros) →
        </a>
    </div>
</section>

<script>
    // Importar datos de libros al cliente para filtrado dinámico
    import libraryData from "../../data/processed/library.json";
    const allBooks = libraryData.books;

    document.addEventListener("DOMContentLoaded", () => {
        const buttons = document.querySelectorAll(".filter-btn");
        const grid = document.getElementById("books-grid");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Actualizar UI botones
                buttons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                // Filtrar
                const filterType = btn.getAttribute("data-filter");
                let filteredBooks: any[] = [];

                switch (filterType) {
                    case "traveler":
                        filteredBooks = allBooks.filter((b) => b.isTraveler);
                        break;
                    case "art":
                        filteredBooks = allBooks.filter((b) => b.isArtBook);
                        break;
                    case "recent":
                        filteredBooks = allBooks.filter((b) => b.isRecent);
                        break;
                    case "favorite":
                        filteredBooks = allBooks.filter((b) => b.isFavorite);
                        break;
                    default:
                        filteredBooks = allBooks;
                }

                // Renderizar (limitado a 8 para preview)
                renderBooks(filteredBooks.slice(0, 8));
            });
        });

        function renderBooks(books: any[]) {
            if (!grid) return;
            grid.innerHTML = books
                .map(
                    (book: any) => `
        <a href="/biblioteca/libro/\${book.slug}" class="book-card-mini fade-in">
          <div class="card-cover">
            \${
                book.coverUrl
                    ? \`<img src="\${book.coverUrl}" alt="\${book.title}" loading="lazy" />\`
                    : \`<div class="placeholder-cover">\${book.title[0]}</div>\`
            }
          </div>
          <div class="card-info">
            <h4>\${book.title}</h4>
            <p>\${book.authors[0] || "Autor desconocido"}</p>
          </div>
        </a>
      `,
                )
                .join("");
        }
    });
</script>

<style>
    .collection-preview {
        padding: 4rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 2rem;
    }

    .filters-scroll {
        overflow-x: auto;
        padding-bottom: 1rem;
        /* Ocultar barra de scroll pero permitir funcionalidad */
        scrollbar-width: none;
    }

    .filters-scroll::-webkit-scrollbar {
        display: none;
    }

    .filters-container {
        display: flex;
        gap: 1rem;
        justify-content: center;
        min-width: max-content;
    }

    .filter-btn {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        cursor: pointer;
        font-family: var(--font-body);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-color);
    }

    .filter-btn:hover,
    .filter-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.2);
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .book-card-mini {
        background: var(--surface-color);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
    }

    .book-card-mini:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .card-cover {
        aspect-ratio: 2/3;
        overflow: hidden;
        background: #f0f0f0;
        position: relative;
    }

    .card-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .book-card-mini:hover .card-cover img {
        transform: scale(1.05);
    }

    .placeholder-cover {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #ccc;
        background: #eee;
    }

    .card-info {
        padding: 1rem;
    }

    .card-info h4 {
        margin: 0 0 0.5rem 0;
        font-size: 1rem;
        font-family: var(--font-heading);
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-info p {
        margin: 0;
        font-size: 0.85rem;
        opacity: 0.7;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .actions {
        text-align: center;
    }

    .btn-outline {
        display: inline-block;
        padding: 0.8rem 2rem;
        border: 2px solid var(--primary-color);
        border-radius: 50px;
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-outline:hover {
        background: var(--primary-color);
        color: white;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-in {
        animation: fadeIn 0.3s ease forwards;
    }
</style>
