---
import { REVEAL_DATE } from "../lib/constants";
import bookCovers from "../data/bookCovers.json";

const ahora = new Date();
const haLlegado = ahora >= REVEAL_DATE;

// Seleccionar 12 portadas aleatorias para flotar
const floatingCovers = bookCovers
    .filter((b) => b.hasCover && b.localUrl !== "/images/library-cover.svg")
    .sort(() => Math.random() - 0.5)
    .slice(0, 12);
---

<div class="transition-portal" id="transitionPortal" style="display: none;">
    <div class="portal-overlay"></div>

    <!-- Fondo de los Reyes Magos -->
    <div class="reyes-background">
        <img src="/images/reyes-magos.png" alt="" class="reyes-art" />
    </div>

    <div class="portal-content">
        <!-- Estrella de Oriente -->
        <div class="guiding-star"></div>
        <div class="star-field">
            <div class="shooting-star"></div>
            <div class="star-dot" style="top: 10%; left: 20%; --d: 0s;"></div>
            <div class="star-dot" style="top: 15%; left: 80%; --d: 1s;"></div>
            <div class="star-dot" style="top: 40%; left: 10%; --d: 2s;"></div>
            <div class="star-dot" style="top: 60%; left: 85%; --d: 0.5s;"></div>
            <div class="star-dot" style="top: 25%; left: 50%; --d: 1.5s;"></div>
            <div class="star-dot" style="top: 80%; left: 30%; --d: 2.5s;"></div>
            <div class="star-dot" style="top: 75%; left: 70%; --d: 0.8s;"></div>
        </div>

        <div class="magic-gift-container">
            <div class="floating-covers">
                {
                    floatingCovers.map((cover, i) => (
                        <div
                            class="floating-book"
                            style={`--delay: ${i * 0.5}s; --x: ${Math.random() * 200 - 100}px; --y: ${Math.random() * 200 - 100}px;`}
                        >
                            <img src={cover.localUrl} alt="" />
                        </div>
                    ))
                }
            </div>

            <div class="magic-book-gift">
                <img
                    src="/images/library-cover.svg"
                    alt="Biblioteca Cantaribeña"
                    class="gift-book-cover"
                />
                <div class="gift-glow"></div>
            </div>
            <div class="magic-sparks">
                {
                    Array.from({ length: 20 }).map((_, i) => (
                        <div
                            class="sparkle"
                            style={`--delay: ${Math.random() * 5}s; --x: ${Math.random() * 300 - 150}px; --y: ${Math.random() * 300 - 150}px;`}
                        />
                    ))
                }
            </div>
        </div>

        <div class="portal-message">
            <div class="reyes-crown">👑 👑 👑</div>
            <h2>¡Un Regalo de los Reyes Magos!</h2>
            <p>
                ¡Sus Majestades han llegado con una sorpresa increíble! <br />
                Han dejado estos cuentos cantaribeños para que los disfrutes.
            </p>

            <div class="portal-actions">
                <a href="/biblioteca" class="portal-btn primary">
                    Abrir mi Biblioteca
                </a>
                <button class="portal-btn secondary" id="closePortal">
                    Ver después
                </button>
            </div>
        </div>
    </div>
</div>

<script define:vars={{ revealDateStr: REVEAL_DATE.toISOString() }}>
    // @ts-nocheck
    function initPortal() {
        const portal = document.getElementById("transitionPortal");
        const closeBtn = document.getElementById("closePortal");
        const revealDate = new Date(revealDateStr);

        function checkReveal() {
            const ahora = new Date();
            const hasArrived = ahora >= revealDate;
            const alreadyShown = localStorage.getItem("portalShown") === "true";

            if (hasArrived && !alreadyShown && portal) {
                portal.style.display = "block";
                setTimeout(() => {
                    portal.classList.add("visible");
                    // Confetti explosion effect on show
                    createConfetti();
                }, 100);
            }
        }

        function createConfetti() {
            const colors = [
                "#ffb703",
                "#fb8500",
                "#219EBC",
                "#8CB369",
                "#ffffff",
            ];
            for (let i = 0; i < 50; i++) {
                const confetti = document.createElement("div");
                confetti.className = "confetti-piece";
                confetti.style.background =
                    colors[Math.floor(Math.random() * colors.length)];
                confetti.style.left = "50%";
                confetti.style.top = "50%";
                confetti.style.setProperty(
                    "--tx",
                    `${Math.random() * 400 - 200}px`,
                );
                confetti.style.setProperty(
                    "--ty",
                    `${Math.random() * -300 - 50}px`,
                );
                confetti.style.setProperty(
                    "--delay",
                    `${Math.random() * 0.5}s`,
                );
                portal.appendChild(confetti);
                setTimeout(() => confetti.remove(), 3000);
            }
        }

        if (closeBtn && portal) {
            closeBtn.addEventListener("click", () => {
                portal.classList.remove("visible");
                localStorage.setItem("portalShown", "true");
                setTimeout(() => {
                    portal.style.display = "none";
                }, 800);
            });
        }

        // Check periodically
        checkReveal();
        setInterval(checkReveal, 5000);
    }

    initPortal();
    document.addEventListener("astro:page-load", initPortal);
</script>

<style>
    .transition-portal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        opacity: 0;
        transition: opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        overflow: hidden;
    }

    .transition-portal.visible {
        opacity: 1;
        pointer-events: all;
    }

    .portal-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle at center,
            rgba(7, 26, 64, 0.98) 0%,
            rgba(2, 8, 20, 1) 100%
        );
        backdrop-filter: blur(8px);
    }

    .reyes-background {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.5;
        pointer-events: none;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .reyes-art {
        width: 100%;
        max-width: 1200px;
        object-fit: contain;
        filter: drop-shadow(0 0 20px rgba(255, 183, 3, 0.2));
        mask-image: linear-gradient(to top, black 80%, transparent 100%);
    }

    .portal-content {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        color: white;
    }

    /* Estrella de Oriente */
    .guiding-star {
        position: absolute;
        top: 15%;
        width: 4px;
        height: 4px;
        background: white;
        border-radius: 50%;
        box-shadow:
            0 0 20px 2px white,
            0 0 60px 10px rgba(255, 183, 3, 0.8),
            0 0 100px 20px rgba(255, 183, 3, 0.4);
        animation: twinkle 4s ease-in-out infinite;
    }

    @keyframes twinkle {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.8;
        }
        50% {
            transform: scale(1.5);
            opacity: 1;
            box-shadow: 0 0 80px 15px rgba(255, 183, 3, 1);
        }
    }

    /* Portadas flotantes */
    .magic-gift-container {
        margin-bottom: 4rem;
        position: relative;
        perspective: 1200px;
    }

    .floating-covers {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .floating-book {
        position: absolute;
        width: 60px;
        height: 90px;
        top: 50%;
        left: 50%;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
        opacity: 0;
        animation: drift 15s ease-in-out infinite;
        animation-delay: var(--delay);
    }

    .floating-book img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @keyframes drift {
        0% {
            transform: translate(-50%, -50%) scale(0) rotate(0deg);
            opacity: 0;
        }
        20% {
            opacity: 0.6;
        }
        80% {
            opacity: 0.6;
        }
        100% {
            transform: translate(var(--x), var(--y)) scale(1.5) rotate(360deg);
            opacity: 0;
        }
    }

    /* Libro-Regalo */
    .magic-book-gift {
        width: 280px;
        height: 420px;
        position: relative;
        transform-style: preserve-3d;
        animation: hoverGift 6s ease-in-out infinite;
        filter: drop-shadow(0 40px 80px rgba(0, 0, 0, 0.6));
    }

    .gift-book-cover {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        position: relative;
        z-index: 2;
    }

    .gift-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120%;
        height: 120%;
        background: radial-gradient(
            circle,
            rgba(255, 183, 3, 0.4) 0%,
            transparent 70%
        );
        z-index: 1;
        animation: pulse-glow 3s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes pulse-glow {
        0%,
        100% {
            opacity: 0.5;
            transform: translate(-50%, -50%) scale(1);
        }
        50% {
            opacity: 0.8;
            transform: translate(-50%, -50%) scale(1.1);
        }
    }

    /* Estrellas de fondo */
    .star-field {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .star-dot {
        position: absolute;
        width: 2px;
        height: 2px;
        background: white;
        border-radius: 50%;
        animation: blink 3s ease-in-out infinite;
        animation-delay: var(--d);
        opacity: 0.4;
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 0.2;
            transform: scale(1);
        }
        50% {
            opacity: 0.8;
            transform: scale(1.5);
        }
    }

    @keyframes hoverGift {
        0%,
        100% {
            transform: translateY(0) rotateY(-5deg) rotate(0);
        }
        25% {
            transform: translateY(-15px) rotateY(0deg) rotate(-3deg);
        }
        50% {
            transform: translateY(-30px) rotateY(5deg) rotate(2deg);
        }
        75% {
            transform: translateY(-15px) rotateY(0deg) rotate(3deg);
        }
    }

    .magic-book-gift:hover {
        animation: wobble 0.5s ease-in-out infinite;
    }

    @keyframes wobble {
        0%,
        100% {
            transform: translateY(-30px) rotate(0deg);
        }
        25% {
            transform: translateY(-30px) rotate(-5deg);
        }
        75% {
            transform: translateY(-30px) rotate(5deg);
        }
    }

    .portal-message h2 {
        font-family: var(--font-heading), serif;
        font-size: 3.5rem;
        margin-bottom: 1rem;
        font-weight: 700;
        color: #ffb703;
        text-shadow: 0 4px 20px rgba(255, 183, 3, 0.4);
        letter-spacing: -0.01em;
    }

    .reyes-crown {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        filter: drop-shadow(0 0 10px rgba(255, 183, 3, 0.5));
    }

    .portal-message p {
        font-family: var(--font-decorative), serif;
        font-size: 1.6rem;
        opacity: 0.9;
        margin-bottom: 3rem;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .portal-btn {
        padding: 1.2rem 3rem;
        border-radius: 50px;
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 700;
        text-transform: none;
        letter-spacing: 0.02em;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: none;
    }

    .portal-btn.primary {
        background: linear-gradient(135deg, #ffb703 0%, #fb8500 100%);
        color: white;
        box-shadow:
            0 15px 35px rgba(255, 183, 3, 0.4),
            0 0 20px rgba(255, 183, 3, 0.2);
    }

    .portal-btn.primary:hover {
        transform: translateY(-8px) scale(1.1);
        box-shadow:
            0 25px 50px rgba(255, 183, 3, 0.6),
            0 0 30px rgba(255, 183, 3, 0.4);
    }

    .portal-btn.secondary {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(5px);
    }

    .portal-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-5px);
    }

    @media (max-width: 768px) {
        .portal-message h2 {
            font-size: 2.2rem;
        }
        .portal-message p {
            font-size: 1.3rem;
        }
        .magic-book-gift {
            width: 210px;
            height: 315px;
        }
        .floating-book {
            width: 40px;
            height: 60px;
        }
    }

    /* Estrella fugaz */
    .shooting-star {
        position: absolute;
        top: 20%;
        left: -10%;
        width: 100px;
        height: 2px;
        background: linear-gradient(90deg, white, transparent);
        transform: rotate(140deg);
        animation: shoot 10s linear infinite;
        opacity: 0;
    }

    @keyframes shoot {
        0% {
            transform: translateX(0) rotate(140deg);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        20% {
            transform: translateX(1000px) translateY(800px) rotate(140deg);
            opacity: 0;
        }
        100% {
            transform: translateX(1000px) translateY(800px) rotate(140deg);
            opacity: 0;
        }
    }

    /* Brillos mágicos */
    .magic-sparks {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        pointer-events: none;
        transform: translate(-50%, -50%);
    }

    .sparkle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 4px;
        height: 4px;
        background: #fff;
        border-radius: 50%;
        box-shadow:
            0 0 10px #ffb703,
            0 0 20px #ffb703;
        animation: sparkle-shoot 4s linear infinite;
        animation-delay: var(--delay);
        opacity: 0;
    }

    @keyframes sparkle-shoot {
        0% {
            transform: translate(0, 0) scale(0);
            opacity: 0;
        }
        20% {
            opacity: 1;
        }
        80% {
            opacity: 1;
        }
        100% {
            transform: translate(var(--x), var(--y)) scale(1.5);
            opacity: 0;
        }
    }

    /* Confetti */
    .confetti-piece {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        opacity: 0;
        z-index: 10;
        animation: confetti-fall 3s ease-out forwards;
        animation-delay: var(--delay);
    }

    @keyframes confetti-fall {
        0% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
        25% {
            opacity: 1;
        }
        100% {
            transform: translate(var(--tx), var(--ty)) translate(0, 600px)
                rotate(720deg);
            opacity: 0;
        }
    }
</style>
