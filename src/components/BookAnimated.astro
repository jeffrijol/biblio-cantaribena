---
// src/components/BookAnimated.astro
import bookCovers from "../data/bookCovers.json";

const EXTERIOR_COVER = "/images/library-cover.svg";
// Prepare sequence: Library -> Books... loop handles the reset
const allCovers = [
  EXTERIOR_COVER,
  ...(bookCovers || []).map((b) => b.localUrl),
];
---

<div class="book-animation-container">
  <div class="image-stack" id="stack">
    <img
      id="img-current"
      src={EXTERIOR_COVER}
      alt="Current Cover"
      class="active"
    />
    <img id="img-next" src={allCovers[1]} alt="Next Cover" class="next" />
  </div>

  <!-- Optional: Counter or Controls if needed, user didn't explicitly ask but it's nice to keep context -->
  <div class="book-info">
    <span id="cover-label">Biblioteca</span>
  </div>
</div>

<style>
  .book-animation-container {
    width: 100%;
    max-width: 400px; /* Reduced max-width for better focus */
    aspect-ratio: 2/3; /* Standard book ratio */
    margin: 0 auto;
    position: relative;
    perspective: 1500px;
  }

  .image-stack {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain; /* Or cover, depending on image aspect */
    backface-visibility: hidden;
    border-radius: 8px; /* Soft edges */
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    background: #fff; /* Fallback */
    transform-origin: bottom left;
    transition:
      transform 1.5s cubic-bezier(0.645, 0.045, 0.355, 1),
      opacity 1.5s ease;
  }

  img.active {
    z-index: 2;
    transform: rotate(0deg);
    opacity: 1;
  }

  img.next {
    z-index: 1;
    transform: rotate(0deg);
  }

  /* The 'lift' animation class */
  img.lifting {
    /* Transform origin is bottom-left, so rotating negative makes it swing up-left */
    transform: rotateZ(-90deg) rotateY(20deg);
    opacity: 0; /* Fade out as it lifts to reveal next */
    /* To make it look like a page turn from bottom-left, we swing it away */
  }

  .book-info {
    margin-top: 1rem;
    text-align: center;
    font-family: var(--font-body, sans-serif);
    color: var(--color-ink, #333);
    font-size: 0.9rem;
  }
</style>

<script>
  interface BookCover {
    localUrl: string;
    // other props if needed
  }

  const coversElement = document.getElementById("covers-data");
  const coversData: BookCover[] =
    coversElement && coversElement.textContent
      ? JSON.parse(coversElement.textContent)
      : [];

  const EXTERIOR_COVER = "/images/library-cover.svg";

  // Sequence order: LibraryCover (index 0) ... Books ... -> Loop
  const sequence = [EXTERIOR_COVER, ...coversData.map((c: any) => c.localUrl)];

  let currentIndex = 0;
  const imgCurrent = document.getElementById("img-current") as HTMLImageElement;
  const imgNext = document.getElementById("img-next") as HTMLImageElement;
  const label = document.getElementById("cover-label");

  // Durations
  const LIBRARY_DURATION = 10000;
  const BOOK_DURATION = 4000; // 4 seconds for books to be readable
  const ANIMATION_DURATION = 1500; // Match CSS transition

  function updateLabel(index: number) {
    if (!label) return;
    if (index === 0) {
      label.textContent = "Biblioteca";
    } else {
      const bookIndex = index - 1;
      if (bookIndex >= 0 && bookIndex < coversData.length) {
        label.textContent = `Libro ${bookIndex + 1}`;
      }
    }
  }

  function step() {
    if (!imgCurrent || !imgNext) return;

    // 1. Calculate next index
    const nextIndex = (currentIndex + 1) % sequence.length;

    // 2. Animate 'current' element lifting up
    imgCurrent.classList.add("lifting");

    // 3. After animation finishes
    setTimeout(() => {
      // Swap logic
      if (!imgCurrent || !imgNext) return;

      imgCurrent.src = sequence[nextIndex];
      imgCurrent.classList.remove("lifting");

      currentIndex = nextIndex;
      updateLabel(currentIndex);

      // Now prepare the underlying 'next' for the NEXT step
      const subsequentIndex = (nextIndex + 1) % sequence.length;
      imgNext.src = sequence[subsequentIndex];

      // Schedule next step
      const delay = currentIndex === 0 ? LIBRARY_DURATION : BOOK_DURATION;
      setTimeout(step, delay);
    }, ANIMATION_DURATION);
  }

  // Initial Start
  if (imgCurrent && imgNext && sequence.length > 1) {
    setTimeout(step, LIBRARY_DURATION);
  }
</script>

<script
  id="covers-data"
  type="application/json"
  set:html={JSON.stringify(bookCovers)}
/>
