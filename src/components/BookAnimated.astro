---
// src/components/BookAnimated.astro
import bookCovers from "../data/bookCovers.json";

const covers = bookCovers || [];
const EXTERIOR_COVER = "/images/library-cover.svg";
---

<div class="book-triple-container">
  <div class="book-perspective-wrapper">
    <!-- El libro en sí -->
    <div class="book-entity" id="book-entity">
      <!-- Lomo del libro -->
      <div class="book-spine-real"></div>

      <!-- PÁGINA IZQUIERDA -->
      <div class="page page-left" id="page-left">
        <div class="page-content">
          <img
            src={EXTERIOR_COVER}
            alt="Biblioteca"
            id="img-left"
            class="page-img"
          />
          <div class="page-shadow-inner"></div>
        </div>
      </div>

      <!-- PÁGINA DERECHA -->
      <div class="page page-right" id="page-right">
        <div class="page-content">
          <img
            src={covers.length > 0 ? covers[0].localUrl : EXTERIOR_COVER}
            alt="Siguiente"
            id="img-right"
            class="page-img"
          />
          <div class="page-shadow-inner"></div>
        </div>
      </div>

      <!-- PÁGINA VOLANTE (La que gira) -->
      <div class="page page-middle" id="page-middle">
        <!-- Cara A (Frontal de la hoja que vuela) -->
        <div class="page-face face-front">
          <div class="page-content">
            <img
              src={EXTERIOR_COVER}
              alt="Flipping Front"
              id="img-mid-front"
              class="page-img"
            />
            <div class="page-gloss-effect"></div>
          </div>
        </div>
        <!-- Cara B (Trasera de la hoja que vuela) -->
        <div class="page-face face-back">
          <div class="page-content">
            <img
              src={covers.length > 0 ? covers[0].localUrl : EXTERIOR_COVER}
              alt="Flipping Back"
              id="img-mid-back"
              class="page-img"
            />
            <div class="page-gloss-effect"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Controles e Información -->
  <div class="book-info-panel">
    <div class="progress-pill">
      <span id="book-counter">Biblioteca</span>
    </div>
    <p class="click-hint">Haz clic para hojear la biblioteca</p>
  </div>
</div>

<style>
  /* VARIABLES Y RESET LOCAL */
  .book-triple-container {
    --book-width: 280px;
    --book-height: 420px;
    --anim-speed: 1.2s;
    --page-fold-color: #f4f4f4;

    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .book-perspective-wrapper {
    perspective: 2000px;
    width: var(--book-width);
    height: var(--book-height);
    position: relative;
    transition: transform 0.8s ease-in-out;
  }

  .book-entity {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .book-spine-real {
    position: absolute;
    left: 0;
    width: 12px;
    height: 100%;
    background: var(--color-ink);
    transform: rotateY(-90deg);
    transform-origin: right;
    z-index: 5;
  }

  .page {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    transform-origin: left;
    transform-style: preserve-3d;
    transition: transform var(--anim-speed) cubic-bezier(0.645, 0.045, 0.355, 1);
    border-radius: 0 8px 8px 0;
    overflow: hidden;
    background: white;
    box-shadow: 5px 10px 20px rgba(0, 0, 0, 0.1);
  }

  .page-content {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .page-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: white;
  }

  .page-shadow-inner {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0) 10%
    );
    pointer-events: none;
  }

  /* PÁGINAS ESPECÍFICAS */
  .page-left {
    z-index: 1;
    transform: rotateY(0deg); /* Empieza cerrado */
  }

  .page-right {
    z-index: 0;
    transform: rotateY(0deg);
  }

  .page-middle {
    z-index: 10;
    cursor: pointer;
    transform: rotateY(0deg);
    display: none;
  }

  /* CARAS DE LA HOJA VOLANTE */
  .page-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .face-back {
    transform: rotateY(180deg);
    background: var(--page-fold-color);
  }

  .page-gloss-effect {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0) 40%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0) 60%
    );
    pointer-events: none;
  }

  /* ESTADOS */
  .book-triple-container.is-open .page-left {
    transform: rotateY(-180deg);
    z-index: 1;
    border-radius: 8px 0 0 8px;
  }
  .book-triple-container.is-open .page-middle {
    display: block;
  }
  .book-triple-container.is-open .book-perspective-wrapper {
    transform: translateX(calc(var(--book-width) * 0.5));
  }

  /* INFO */
  .book-info-panel {
    text-align: center;
    font-family: var(--font-body);
  }
  .progress-pill {
    background: rgba(255, 255, 255, 0.9);
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
    font-size: 0.9rem;
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    margin-bottom: 0.5rem;
    display: inline-block;
  }
  .click-hint {
    font-size: 0.8rem;
    opacity: 0.6;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .book-triple-container {
      --book-width: 220px;
      --book-height: 330px;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector(".book-triple-container");
      const pageMiddle = document.getElementById("page-middle");
      const imgLeft = document.getElementById("img-left") as HTMLImageElement;
      const imgRight = document.getElementById("img-right") as HTMLImageElement;
      const imgMidFront = document.getElementById(
        "img-mid-front",
      ) as HTMLImageElement;
      const imgMidBack = document.getElementById(
        "img-mid-back",
      ) as HTMLImageElement;
      const counter = document.getElementById("book-counter");

      const dataEl = document.getElementById("book3d-data");
      const covers = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
      const exterior = "/images/library-cover.svg";

      if (!covers.length) return;

      let currentIndex = -1; // -1 = Cerrado
      let isForward = true;
      let isAnimating = false;
      const FLIP_DURATION = 1200;
      const CYCLE_DELAY = 8000;

      function flip() {
        if (isAnimating) return;
        isAnimating = true;

        // APERTURA INICIAL
        if (currentIndex === -1) {
          container?.classList.add("is-open");
          currentIndex = 0;

          imgMidFront.src = exterior;
          imgMidBack.src = covers[0].localUrl;
          imgRight.src = covers[1] ? covers[1].localUrl : exterior;

          setTimeout(() => {
            if (pageMiddle) pageMiddle.style.transform = "rotateY(-180deg)";
          }, 50);

          setTimeout(() => {
            imgLeft.src = exterior;
            isAnimating = false;
            updateCounter();
          }, FLIP_DURATION + 100);
          return;
        }

        // CAMBIO DE DIRECCIÓN
        if (isForward && currentIndex >= covers.length - 1) isForward = false;
        if (!isForward && currentIndex <= 0) isForward = true;

        if (!pageMiddle) return;

        if (isForward) {
          currentIndex++;
          imgMidFront.src = covers[currentIndex - 1].localUrl;
          imgMidBack.src = covers[currentIndex].localUrl;
          imgRight.src = covers[currentIndex + 1]
            ? covers[currentIndex + 1].localUrl
            : exterior;

          pageMiddle.style.transition = "none";
          pageMiddle.style.transform = "rotateY(0deg)";

          setTimeout(() => {
            pageMiddle.style.transition = `transform ${FLIP_DURATION}ms cubic-bezier(0.645, 0.045, 0.355, 1)`;
            pageMiddle.style.transform = "rotateY(-180deg)";
          }, 50);

          setTimeout(() => {
            imgLeft.src = covers[currentIndex - 1].localUrl;
            isAnimating = false;
            updateCounter();
          }, FLIP_DURATION + 100);
        } else {
          currentIndex--;
          imgMidBack.src = covers[currentIndex + 1].localUrl;
          imgMidFront.src = covers[currentIndex].localUrl;
          imgLeft.src =
            currentIndex > 0 ? covers[currentIndex - 1].localUrl : exterior;

          pageMiddle.style.transition = "none";
          pageMiddle.style.transform = "rotateY(-180deg)";

          setTimeout(() => {
            pageMiddle.style.transition = `transform ${FLIP_DURATION}ms cubic-bezier(0.645, 0.045, 0.355, 1)`;
            pageMiddle.style.transform = "rotateY(0deg)";
          }, 50);

          setTimeout(() => {
            imgRight.src = covers[currentIndex + 1].localUrl;
            isAnimating = false;
            updateCounter();
          }, FLIP_DURATION + 100);
        }
      }

      function updateCounter() {
        if (counter) {
          if (currentIndex === -1) counter.textContent = "Biblioteca";
          else
            counter.textContent = `Libro ${currentIndex + 1} de ${covers.length} ${!isForward ? "⇜" : "⇝"}`;
        }
      }

      let autoTimer = setInterval(flip, CYCLE_DELAY);

      container?.addEventListener("click", (e) => {
        // Evitar que el click se propague si es solo decorativo
        clearInterval(autoTimer);
        flip();
        autoTimer = setInterval(flip, CYCLE_DELAY);
      });

      updateCounter();
    });
  }
</script>

<script
  id="book3d-data"
  type="application/json"
  set:html={JSON.stringify(covers)}
/>
