---
// src/components/BookAnimated.astro
import bookCovers from '../data/bookCovers.json';

// Si no hay datos, usar array vacío
const covers = bookCovers || [];
const hasCovers = covers.length > 0;
---

<div class="book-animated-container">
  {hasCovers ? (
    <div class="book-system">
      <div class="book-depth-layer depth-1"></div>
      <div class="book-depth-layer depth-2"></div>
      <div class="book-depth-layer depth-3"></div>
      
      <div class="book-main" id="animated-book-container">
        <!-- Lomo del libro -->
        <div class="book-spine-3d"></div>
        
        <!-- Portada frontal (la que gira) -->
        <div class="book-front" id="book-front-wing">
          <div class="book-cover-image">
             <img
              id="animated-book-cover"
              src={covers[0].coverUrl}
              alt={`Portada de ${covers[0].title}`}
              loading="lazy"
              data-covers={JSON.stringify(covers.map(c => ({ url: c.coverUrl, title: c.title })))}
            />
            <div class="book-gloss"></div>
          </div>
          <div class="book-cover-back"></div>
        </div>

        <!-- Páginas interiores estáticas -->
        <div class="book-pages-stack">
          <div class="inner-page"></div>
        </div>
      </div>
      
      <!-- Indicador de progreso -->
      <div class="cover-progress">
        <div class="progress-bar">
          <div class="progress-fill" id="cover-progress-fill"></div>
        </div>
        <div class="progress-text" id="cover-progress-text">
          Libro 1 de {covers.length}
        </div>
      </div>
    </div>
  ) : (
    <div class="book-placeholder page-turn">
      <div class="book-cover-fallback">
        <div class="book-spine"></div>
        <div class="book-pages">
          <div class="page"></div>
          <div class="page"></div>
          <div class="page"></div>
        </div>
      </div>
      <p class="placeholder-text">Cargando biblioteca...</p>
    </div>
  )}
</div>

<style>
/* Contenedor principal */
.book-animated-container {
  width: 100%;
  max-width: 320px;
  margin: 0 auto;
  padding: 2rem 0;
}

.book-system {
  position: relative;
  width: 280px;
  height: 420px;
  margin: 0 auto;
  perspective: 2000px;
}

/* Base del libro (cuerpo principal) */
.book-main {
  position: absolute;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  animation: bookIdle 6s ease-in-out infinite;
}

/* Lomo 3D */
.book-spine-3d {
  position: absolute;
  left: -15px;
  width: 30px;
  height: 100%;
  background: var(--color-primary-dark);
  transform: rotateY(-90deg);
  transform-origin: right;
  border-radius: 4px 0 0 4px;
  box-shadow: inset -5px 0 10px rgba(0,0,0,0.3);
}

/* Capa frontal (Portada que gira) */
.book-front {
  position: absolute;
  width: 100%;
  height: 100%;
  transform-origin: left;
  transform-style: preserve-3d;
  z-index: 10;
  transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.book-cover-image {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  background: #f0f0f0;
  border-radius: 0 8px 8px 0;
  overflow: hidden;
  box-shadow: 10px 10px 20px rgba(0,0,0,0.15);
}

.book-cover-image img {
  width: 100%;
  height: 100%;
  object-fit: contain; /* Cambiado para que encaje la URL */
  background: #eee;
}

.book-gloss {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,0.1) 40%,
    rgba(255,255,255,0.2) 42%,
    rgba(255,255,255,0.1) 44%,
    rgba(255,255,255,0) 100%
  );
  pointer-events: none;
}

/* Reverso de la portada (papel blanco) */
.book-cover-back {
  position: absolute;
  width: 100%;
  height: 100%;
  background: var(--color-paper);
  transform: rotateY(180deg);
  backface-visibility: hidden;
  border-radius: 8px 0 0 8px;
  box-shadow: inset 5px 0 15px rgba(0,0,0,0.05);
}

/* Bloque de páginas (estático debajo) */
.book-pages-stack {
  position: absolute;
  width: 98%;
  height: 96%;
  top: 2%;
  left: 1%;
  background: #fff;
  border-radius: 0 4px 4px 0;
  box-shadow: 
    3px 0 0 -1px #eee,
    6px 0 0 -2px #ddd,
    9px 0 0 -3px #ccc;
  z-index: 1;
}

.inner-page {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #f9f9f9 0%, #fff 5%, #fff 95%, #f2f2f2 100%);
}

/* Animación de apertura */
.turning {
  transform: rotateY(-160deg) !important;
}

/* Capas de profundidad visual adicionales */
.book-depth-layer {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.03);
  border-radius: 0 8px 8px 0;
  pointer-events: none;
}
.depth-1 { transform: translateZ(-2px) translateX(2px); }
.depth-2 { transform: translateZ(-4px) translateX(4px); }
.depth-3 { transform: translateZ(-6px) translateX(6px); }

/* Progreso */
.cover-progress {
  margin-top: 3rem;
  text-align: center;
}

.progress-bar {
  width: 100%;
  height: 4px;
  background: rgba(0,0,0,0.1);
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 8px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary-base), var(--color-secondary-base));
  width: 0%;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 0.85rem;
  color: var(--color-ink);
  opacity: 0.6;
}

/* Efecto de balanceo suave */
@keyframes bookIdle {
  0%, 100% { transform: rotateY(-5deg) rotateX(2deg) translateY(0); }
  50% { transform: rotateY(5deg) rotateX(-2deg) translateY(-10px); }
}

/* Fallback */
.book-placeholder {
  width: 180px;
  height: 260px;
  margin: 0 auto;
}
.book-cover-fallback {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, var(--color-primary-base), var(--color-secondary-base));
  border-radius: 4px 8px 8px 4px;
  position: relative;
  box-shadow: var(--shadow-elevated);
}
.placeholder-text {
  text-align: center; margin-top: 1rem; font-size: 0.8rem; opacity: 0.6;
}
</style>

<script>
if (typeof window !== 'undefined') {
  document.addEventListener('DOMContentLoaded', () => {
    const bookContainer = document.getElementById('animated-book-container');
    const frontWing = document.getElementById('book-front-wing');
    const bookCover = document.getElementById('animated-book-cover') as HTMLImageElement;
    const progressFill = document.getElementById('cover-progress-fill');
    const progressText = document.getElementById('cover-progress-text');
    
    if (!bookCover || !frontWing) return;
    
    const coversData = JSON.parse(bookCover.dataset.covers || '[]');
    if (coversData.length === 0) return;
    
    let currentIdx = 0;
    const total = coversData.length;
    const CYCLE_TIME = 8000;
    
    function flipAndChange() {
      // 1. Iniciar giro de página
      frontWing?.classList.add('turning');
      
      // 2. A mitad del giro, cambiar la imagen (cuando no es visible)
      setTimeout(() => {
        currentIdx = (currentIdx + 1) % total;
        const next = coversData[currentIdx];
        
        if (bookCover) {
          bookCover.src = next.url;
          bookCover.alt = `Portada de ${next.title}`;
        }

        // Actualizar UI
        if (progressFill) progressFill.style.width = `${((currentIdx + 1) / total) * 100}%`;
        if (progressText) progressText.textContent = `Libro ${currentIdx + 1} de ${total}`;
      }, 600); // 600ms es la mitad de la transición de 1.2s

      // 3. Cerrar la página tras el cambio
      setTimeout(() => {
        frontWing?.classList.remove('turning');
      }, 1300);
    }
    
    let interval = setInterval(flipAndChange, CYCLE_TIME);
    
    // Interactividad manual
    frontWing.addEventListener('click', () => {
      clearInterval(interval);
      flipAndChange();
      interval = setInterval(flipAndChange, CYCLE_TIME);
    });

    // Pausar idle en hover (opcional, para mejor visualización manual)
    bookContainer?.addEventListener('mouseenter', () => {
      if (bookContainer) bookContainer.style.animationPlayState = 'paused';
    });
    bookContainer?.addEventListener('mouseleave', () => {
      if (bookContainer) bookContainer.style.animationPlayState = 'running';
    });

    // Inicializar barra
    if (progressFill) progressFill.style.width = `${((currentIdx + 1) / total) * 100}%`;
  });
}
</script>