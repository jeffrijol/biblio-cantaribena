---
// src/components/UI/Button.astro
interface Props {
    variant?: "primary" | "secondary" | "ghost";
    size?: "small" | "medium" | "large";
    fullWidth?: boolean;
    type?: "button" | "submit" | "reset";
    disabled?: boolean;
    className?: string;
}

const {
    variant = "primary",
    size = "medium",
    fullWidth = false,
    type = "button",
    disabled = false,
    className = "",
} = Astro.props;

const variantClasses = {
    primary: "button-primary",
    secondary: "button-secondary",
    ghost: "button-ghost",
};

const sizeClasses = {
    small: "button-small",
    medium: "button-medium",
    large: "button-large",
};

const widthClass = fullWidth ? "button-full-width" : "";
const disabledClass = disabled ? "button-disabled" : "";
---

<button
    class={`button ${variantClasses[variant]} ${sizeClasses[size]} ${widthClass} ${disabledClass} ${className}`}
    type={type}
    disabled={disabled}
>
    <slot />
</button>

<style>
    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border: none;
        border-radius: 8px;
        font-family: var(--font-body);
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition-smooth);
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }

    .button::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.2),
            transparent
        );
        transition: left 0.5s ease;
    }

    .button:hover::before {
        left: 100%;
    }

    /* Variantes */
    .button-primary {
        background: linear-gradient(
            135deg,
            var(--color-primary-base),
            var(--color-primary-dark)
        );
        color: white;
        box-shadow: 0 4px 12px rgba(33, 158, 188, 0.3);
    }

    .button-primary:hover:not(.button-disabled) {
        background: linear-gradient(
            135deg,
            var(--color-primary-dark),
            var(--color-primary-base)
        );
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 158, 188, 0.4);
    }

    .button-secondary {
        background: linear-gradient(
            135deg,
            var(--color-secondary-base),
            var(--color-secondary-dark)
        );
        color: white;
        box-shadow: 0 4px 12px rgba(139, 177, 105, 0.3);
    }

    .button-secondary:hover:not(.button-disabled) {
        background: linear-gradient(
            135deg,
            var(--color-secondary-dark),
            var(--color-secondary-base)
        );
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(139, 177, 105, 0.4);
    }

    .button-ghost {
        background: transparent;
        color: var(--color-primary-dark);
        border: 2px solid var(--color-primary-base);
    }

    .button-ghost:hover:not(.button-disabled) {
        background: rgba(142, 202, 230, 0.1);
        transform: translateY(-2px);
    }

    /* Tamaños */
    .button-small {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

    .button-medium {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }

    .button-large {
        padding: 1rem 2rem;
        font-size: 1.1rem;
    }

    /* Ancho completo */
    .button-full-width {
        width: 100%;
    }

    /* Estado deshabilitado */
    .button-disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    .button-disabled::before {
        display: none;
    }
</style>
