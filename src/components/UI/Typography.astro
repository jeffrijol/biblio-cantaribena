---
// src/components/UI/Typography.astro
interface Props {
    as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "span";
    variant?: "heading" | "subheading" | "body" | "decorative" | "caption";
    className?: string;
}

const { as = "p", variant = "body", className = "" } = Astro.props;
const Tag = as;
const variantClasses: Record<string, string> = {
    heading: "typography-heading",
    subheading: "typography-subheading",
    body: "typography-body",
    decorative: "typography-decorative",
    caption: "typography-caption",
};
---

<Tag class={`${variantClasses[variant]} ${className}`}>
    <slot />
</Tag>

<style>
    .typography-heading {
        font-family: var(--font-heading);
        font-size: 3rem;
        line-height: 1.2;
        font-weight: 700;
        color: var(--color-ink);
        margin-bottom: 1.5rem;
    }

    .typography-subheading {
        font-family: var(--font-heading);
        font-size: 2rem;
        line-height: 1.3;
        font-weight: 600;
        color: var(--color-primary-dark);
        margin-bottom: 1rem;
    }

    .typography-body {
        font-family: var(--font-body);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--color-ink);
        margin-bottom: 1rem;
    }

    .typography-decorative {
        font-family: var(--font-decorative);
        font-size: 1.2rem;
        line-height: 1.5;
        font-style: italic;
        color: var(--color-secondary-dark);
    }

    .typography-caption {
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--color-ink);
        opacity: 0.7;
    }

    @media (max-width: 768px) {
        .typography-heading {
            font-size: 2.5rem;
        }

        .typography-subheading {
            font-size: 1.75rem;
        }
    }
</style>
